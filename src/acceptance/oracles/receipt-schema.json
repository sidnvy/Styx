{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R03 external scenario-instance receipt v1",
  "description": "Structural schema only; receipt.py checks sensitivity, evidence files and provenance tier. No schema proves native execution.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenario": {
          "type": "string",
          "pattern": "^A[0-9]{2}$"
        },
        "os": {
          "enum": [
            "linux",
            "windows",
            "macos"
          ]
        },
        "arch": {
          "enum": [
            "x86_64",
            "aarch64"
          ]
        },
        "manager_mode": {
          "type": "string",
          "minLength": 1
        },
        "topology": {
          "type": "string",
          "minLength": 1
        },
        "runtime_combination": {
          "type": "string",
          "minLength": 1
        },
        "session_generation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scenario",
        "os",
        "arch",
        "manager_mode",
        "topology",
        "runtime_combination",
        "session_generation"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN",
        "NOT_APPLICABLE"
      ]
    },
    "evidence_tier": {
      "enum": [
        "fixture",
        "development_slice",
        "real_executor",
        "final_candidate"
      ]
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "contract_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observer_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "native_execution": {
      "type": "boolean"
    },
    "scope_decision": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "decision_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "owner",
            "decision_sha256",
            "reason"
          ]
        }
      ]
    },
    "negative_controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "effect_count": {
            "type": "integer",
            "minimum": 0
          },
          "accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "effect_count",
          "accepted"
        ]
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "CONFIRMED",
            "UNKNOWN",
            "NOT_REQUIRED"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "reason"
      ]
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "CONFIRMED",
            "UNKNOWN",
            "NOT_REQUIRED"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "reason"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "role"
        ]
      }
    }
  },
  "required": [
    "schema",
    "instance",
    "status",
    "evidence_tier",
    "source_revision",
    "contract_hash",
    "observer_hash",
    "candidate_sha256",
    "native_execution",
    "scope_decision",
    "negative_controls",
    "recovery",
    "cleanup",
    "evidence"
  ]
}
