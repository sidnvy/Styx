+/// The exact-target foreground writer shared by typing and whole-field replacement.
+pub(super) async fn foreground_text_input(
+    pid: u32,
+    xid: u64,
+    object: crate::atspi::native::ObjectRef,
+    text: String,
+    replace: bool,
+) -> ToolResult {
+    if !crate::wayland::keyboard_input_available() {
+        return ToolResult::error("native Wayland virtual keyboard is unavailable")
+            .with_structured(json!({"code":"keyboard_unavailable","effect":"none"}));
+    }
+    let budget = text_typing_budget(&text)
+        + if replace {
+            std::time::Duration::from_millis(200)
+        } else {
+            std::time::Duration::ZERO
+        };
+    let result = spawn_blocking_bounded("foreground element text", budget, move || {
+        if !crate::atspi::native::text_input_ready_ref(&object, false)? {
+            anyhow::bail!("observed target is not an enabled editable element");
+        }
+        crate::wayland::hyprland::activate_exact(xid, pid)?;
+        if !crate::atspi::native::focus_element_ref(&object)? {
+            anyhow::bail!("native element focus was not confirmed");
+        }
+        if !crate::wayland::hyprland::target_is_active(xid, Some(pid))? {
+            anyhow::bail!("target lost compositor focus before typing");
+        }
+        crate::wayland::type_text_focused_once(&text, replace, |_| {
+            if !crate::wayland::hyprland::target_is_active(xid, Some(pid))?
+                || !crate::atspi::native::text_input_ready_ref(&object, true)?
+            {
+                anyhow::bail!("observed text target lost focus or editability");
+            }
+            Ok(())
+        })
+    })
+    .await;
+    let detail = match result {
+        Ok(Ok(())) => return foreground_text_completed_result(),
+        Ok(Err(error)) => format!("{error:#}"),
+        Err(error) => format!("foreground element text task: {error}"),
+    };
+    // A focus change or input could already have happened. Preserve
+    // that uncertainty and its bounded cause; never retry the write.
+    let detail: String = detail.chars().take(512).collect();
+    ToolResult::error(format!(
+        "foreground keyboard input outcome is unconfirmed: {detail}"
+    ))
+    .with_structured(json!({
+        "code":"foreground_input_unknown","effect":"unknown","detail":detail
+    }))
 }
 
