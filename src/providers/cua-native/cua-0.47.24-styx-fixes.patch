+        "false-after-effect",
+        "error-after-effect",
+        "timeout-after-effect",
+    ] {
+        let before = counts.lock().unwrap().setters;
+        let result = set_text_ref_strict(&object, text);
+        assert_eq!(
+            result,
+            if text == "acknowledged" {
+                StrictTextOutcome::Acknowledged
+            } else {
+                StrictTextOutcome::Unknown
+            },
+            "{text}"
+        );
+        let observed = counts.lock().unwrap();
+        assert_eq!(
+            observed.setters,
+            before + 1,
+            "exactly one setter for {text}"
+        );
+        assert_eq!(observed.effects, observed.setters);
+        assert_eq!(
+            (observed.inserts, observed.activates, observed.values),
+            (0, 0, 0),
+            "no second mutation for {text}"
+        );
+    }
+}
