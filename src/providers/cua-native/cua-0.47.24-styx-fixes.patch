+// Styx's Host-only strict mode keeps the standard snapshot/session resolver.
+// No second acquire tool, retained private target cache or fallback route exists.
+impl SetValueTool {
+    async fn strict_text(&self, args: Value) -> ToolResult {
+        use crate::atspi::native::StrictTextOutcome;
+        use cua_driver_core::tool_args::ArgsExt;
+        let pid = match args.require_u32("pid") {
+            Ok(pid) if pid > 0 && pid <= i32::MAX as u32 => pid,
+            _ => return strict_text_result(StrictTextOutcome::Refused("invalid_request")),
+        };
+        let value = match args.get("value").and_then(Value::as_str) {
+            Some(value) if value.len() <= 16 * 1024 => value.to_owned(),
+            _ => return strict_text_result(StrictTextOutcome::Refused("invalid_request")),
+        };
+        let resolved = match self.state.snapshots.resolve(pid as i32, &args) {
+            Ok(resolved) => resolved,
+            Err(_) => return strict_text_result(StrictTextOutcome::Refused("stale_observation")),
+        };
+        let token = match prove_token_element(pid, &resolved, "set_value").await {
+            Ok(Some(token)) => token,
+            _ => return strict_text_result(StrictTextOutcome::Refused("stale_observation")),
+        };
+        if refuse_if_disabled(pid, &resolved, "set_value")
+            .await
+            .is_some()
+        {
+            return strict_text_result(StrictTextOutcome::Refused("permission_denied"));
+        }
+        let object = match token.object() {
+            Ok(object) => object.clone(),
+            Err(_) => {
+                return strict_text_result(StrictTextOutcome::Refused("editable_unavailable"))
+            }
+        };
+        // TokenElement::act can retry an ordinal after an error. Strict mode
+        // deliberately uses only the exact cached ObjectRef and one setter.
+        let outcome = tokio::task::spawn_blocking(move || {
+            crate::atspi::native::set_text_ref_strict(&object, &value)
+        })
+        .await
+        .unwrap_or(StrictTextOutcome::Unknown);
+        strict_text_result(outcome)
+    }
+}
+
+fn strict_text_result(outcome: crate::atspi::native::StrictTextOutcome) -> ToolResult {
+    use crate::atspi::native::StrictTextOutcome;
+    let (outcome, code) = match outcome {
+        StrictTextOutcome::Acknowledged => ("acknowledged", None),
+        StrictTextOutcome::Refused(code) => ("refused", Some(code)),
+        StrictTextOutcome::Unknown => ("unknown", Some("native_write_unknown")),
+    };
+    let mut data = json!({"schema":1,"outcome":outcome,"effect":"unverified"});
+    let result = if let Some(code) = code {
+        data["code"] = json!(code);
+        ToolResult::error(code)
+    } else {
+        ToolResult::text("strict_text_acknowledged")
+    };
+    result.with_structured(data)
+}
