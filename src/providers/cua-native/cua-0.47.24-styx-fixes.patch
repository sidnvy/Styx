+/// Whether the exact cached object can receive foreground text. A readable or
+/// focusable button/document is not an editable target. No value is read here.
+pub fn text_input_ready_ref(object_ref: &ObjectRef, require_focus: bool) -> Result<bool> {
+    bounded_for(
+        REF_ACTION_BUDGET,
+        async {
+            let conn = shared_connection().await?;
+            let (acc, _) = live_accessible(conn, object_ref).await?;
+            match call(acc.get_state()).await {
+                Some(Ok(state)) => Ok(text_input_state_ready(&state, require_focus)),
+                Some(Err(error)) => Err(anyhow!("cached text target state unavailable: {error}")),
+                None => Err(anyhow!("cached text target state timed out")),
+            }
+        },
+        || Err(anyhow!("cached text target state timed out")),
+    )
+}
+
+fn text_input_state_ready(state: &StateSet, require_focus: bool) -> bool {
+    is_enabled_state(state)
+        && state.contains(State::Editable)
+        && (!require_focus || state.contains(State::Focused))
+}
+
+#[cfg(test)]
+#[test]
+fn foreground_text_requires_an_enabled_editable_exact_target() {
+    let editable = StateSet::new(State::Editable | State::Enabled);
+    assert!(text_input_state_ready(&editable, false));
+    assert!(!text_input_state_ready(&editable, true));
+    assert!(text_input_state_ready(
+        &StateSet::new(State::Editable | State::Sensitive | State::Focused),
+        true
+    ));
+    assert!(!text_input_state_ready(
+        &StateSet::new(State::Enabled | State::Focused),
+        false
+    ));
+    assert!(!text_input_state_ready(
+        &StateSet::new(State::Editable | State::Focused),
+        false
+    ));
+}
