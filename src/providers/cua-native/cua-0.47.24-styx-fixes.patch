+// Styx's bounded semantic text route reuses the upstream snapshot resolver.
+// It has no acquisition cache, numeric coercion, focus/click/activation or retry.
+fn strict_text_result(outcome: &str, code: Option<&str>) -> ToolResult {
+    let mut structured = serde_json::json!({"schema":1,"outcome":outcome,"effect":"unverified"});
+    if let Some(code) = code {
+        structured["code"] = serde_json::json!(code);
+    }
+    let result = if outcome == "acknowledged" {
+        ToolResult::text("AXValue setter acknowledged; application effect is unverified.")
+    } else {
+        ToolResult::error("Strict AXValue text write was not acknowledged.")
+    };
+    result.with_structured(structured)
+}
+async fn strict_text_once(state: &Arc<ToolState>, args: &Value) -> ToolResult {
+    if args.get("styx_strict_text") != Some(&Value::Bool(true)) {
+        return strict_text_result("refused", Some("invalid_request"));
+    }
+    let Some(value) = args
+        .get("value")
+        .and_then(Value::as_str)
+        .filter(|v| v.len() <= 65536)
+    else {
+        return strict_text_result("refused", Some("invalid_request"));
+    };
+    let pid = match super::target_pid(state, args) {
+        Ok(pid) if pid > 0 => pid,
+        _ => return strict_text_result("refused", Some("process_unavailable")),
+    };
+    let (window, element) = match state.snapshots.resolve(pid, args) {
+        Ok(cua_driver_core::element_token::ResolvedElement::Element {
+            window_id, element, ..
+        }) => match u32::try_from(window_id) {
+            Ok(window) if window > 0 => (window, element),
+            _ => return strict_text_result("refused", Some("window_unavailable")),
+        },
+        Ok(_) => return strict_text_result("refused", Some("invalid_request")),
+        Err(_) => return strict_text_result("refused", Some("stale_observation")),
+    };
+    let _lease = match super::gate_background_window_action(
+        pid,
+        window,
+        Some(element.as_ptr()),
+        cua_driver_core::background_input::BackgroundAction::AxSemantic,
+    )
+    .await
+    {
+        Ok(lease) => lease,
+        Err(_) => return strict_text_result("refused", Some("window_unavailable")),
+    };
+    let value = value.to_owned();
+    let result = tokio::task::spawn_blocking(move || unsafe {
+        use crate::ax::bindings::{AXIsProcessTrusted, is_attribute_settable, set_string_attr};
+        if !AXIsProcessTrusted() {
+            return strict_text_result("refused", Some("permission_denied"));
+        }
+        let target = element.as_ptr() as AXUIElementRef;
+        if !matches!(
+            copy_string_attr(target, "AXRole").as_deref(),
+            Some("AXTextField" | "AXTextArea")
+        ) || copy_string_attr(target, "AXSubrole").as_deref() == Some("AXSecureTextField")
+            || copy_bool_attr(target, "AXEnabled") != Some(true)
+            || copy_string_attr(target, "AXValue").is_none()
+            || !is_attribute_settable(target, "AXValue")
+        {
+            return strict_text_result("refused", Some("editable_unavailable"));
+        }
+        // Exactly one setter dispatch. All errors after entry, including an AX
+        // messaging timeout, are unknown; no fallback or inferred non-dispatch.
+        let code = set_string_attr(target, "AXValue", &value);
+        strict_text_result(
+            if code == kAXErrorSuccess {
+                "acknowledged"
+            } else {
+                "unknown"
+            },
+            None,
+        )
+    })
+    .await;
+    result.unwrap_or_else(|_| strict_text_result("unknown", None))
