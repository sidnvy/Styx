+            before.inserts + inserts,
+            "ordinary false fallback for {text}"
+        );
+        assert_eq!(
+            observed.activates,
+            before.activates + usize::from(success),
+            "normal successful commit for {text}"
+        );
+        assert_eq!(
+            observed.values, before.values,
+            "no numeric fallback for {text}"
+        );
+        assert_eq!(
+            observed.resolutions, before.resolutions,
+            "no ordinal retry for {text}"
+        );
+    }
+    // A missing object precedes any write and retains the ordinary index lookup.
+    token.observed.object_ref = None;
+    let before = counts.lock().unwrap().clone();
+    assert!(set_value_token(424242, &token, "missing-object").is_err());
+    let observed = counts.lock().unwrap();
+    assert!(observed.resolutions > before.resolutions);
+    assert_eq!(observed.setters, before.setters);
+    assert_eq!(observed.effects, before.effects);
+}
