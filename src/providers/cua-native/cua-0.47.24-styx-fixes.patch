+    for (text, success, inserts) in [
+        ("acknowledged", true, 0),
+        ("explicit-false", true, 1),
+        ("error-after-effect", false, 0),
+        ("insert-error-after-effect", false, 1),
+        ("timeout-after-effect", false, 0),
+    ] {
