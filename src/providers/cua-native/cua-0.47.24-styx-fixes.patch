+// Styx owns admission, operation identity and no replay. This route only narrows
+// the existing retained-object setter; it has no second tree, target cache,
+// cursor, focus, alternate native setter or independent authorization policy.
+impl SetValueTool {
+    async fn invoke_strict_text(&self, args: Value) -> ToolResult {
+        let Some(pid) = args
+            .get("pid")
+            .and_then(Value::as_u64)
+            .filter(|pid| *pid > 0 && *pid <= i32::MAX as u64)
+        else {
+            return strict_text_result("refused", Some("invalid_request"));
+        };
+        let Some(window_id) = args
+            .get("window_id")
+            .and_then(Value::as_u64)
+            .filter(|id| *id > 0)
+        else {
+            return strict_text_result("refused", Some("invalid_request"));
+        };
+        let Some(value) = args
+            .get("value")
+            .and_then(Value::as_str)
+            .filter(|value| value.len() <= 16 * 1024)
+        else {
+            return strict_text_result("refused", Some("invalid_request"));
+        };
+        if args
+            .get("element_token")
+            .and_then(Value::as_str)
+            .and_then(cua_driver_core::element_token::parse_token)
+            .is_none()
+        {
+            return strict_text_result("refused", Some("invalid_request"));
+        }
+        let resolved = match self.state.snapshots.resolve(pid as i32, &args) {
+            Ok(resolved) => resolved,
+            Err(_) => return strict_text_result("refused", Some("stale_observation")),
+        };
+        let (_, Some(retained_window), Some(admitted)) = resolved.into_parts(None) else {
+            return strict_text_result("refused", Some("stale_observation"));
+        };
+        if retained_window != window_id || !admitted.is_uia() {
+            return strict_text_result("refused", Some("editable_unavailable"));
+        }
+        let value = value.to_owned();
+        let result = tokio::task::spawn_blocking(move || {
+            use windows::core::{BSTR, Interface};
+            use windows::Win32::UI::Accessibility::{
+                IUIAutomationElement, IUIAutomationValuePattern, UIA_EditControlTypeId,
+                UIA_ValuePatternId,
+            };
+            // The original retained element owns this COM reference throughout
+            // the call; no lookup by label/index or reconstructed UIA object.
+            let element = std::mem::ManuallyDrop::new(unsafe {
+                IUIAutomationElement::from_raw(admitted.as_ptr() as *mut _)
+            });
+            let eligible = unsafe {
+                (|| -> windows::core::Result<bool> {
+                    Ok(element.CurrentProcessId()? == pid as i32
+                        && element.CurrentControlType()? == UIA_EditControlTypeId
+                        && element.CurrentIsEnabled()?.as_bool()
+                        && !element.CurrentIsPassword()?.as_bool())
+                })()
+            };
+            if !matches!(eligible, Ok(true)) {
+                return strict_text_result("refused", Some("editable_unavailable"));
+            }
+            let pattern = match unsafe { element.GetCurrentPattern(UIA_ValuePatternId) }
+                .and_then(|pattern| pattern.cast::<IUIAutomationValuePattern>())
+            {
+                Ok(pattern) => pattern,
+                Err(_) => return strict_text_result("refused", Some("editable_unavailable")),
+            };
+            if !matches!(unsafe { pattern.CurrentIsReadOnly() }, Ok(read_only) if !read_only.as_bool()) {
+                return strict_text_result("refused", Some("editable_unavailable"));
+            }
+            // From this point an HRESULT failure (including timeout) is unknown:
+            // the target may already have handled the write. No fallback/retry.
+            match unsafe { pattern.SetValue(&BSTR::from(value.as_str())) } {
+                Ok(()) => strict_text_result("acknowledged", None),
+                Err(_) => strict_text_result("unknown", None),
+            }
+        }).await;
+        match result {
+            Ok(result) => result,
+            // Losing the worker reply cannot prove that SetValue was not sent.
+            Err(_) => strict_text_result("unknown", None),
+        }
+    }
+}
+
+fn strict_text_result(outcome: &'static str, code: Option<&'static str>) -> ToolResult {
+    let mut content = json!({"schema":1,"outcome":outcome,"effect":"unverified"});
+    if let Some(code) = code {
+        content["code"] = json!(code);
+    }
+    let mut result = if outcome == "acknowledged" {
+        ToolResult::text("strict_text_write_acknowledged")
+    } else {
+        ToolResult::error(if outcome == "refused" {
+            "strict_text_write_refused"
+        } else {
+            "strict_text_write_unknown"
+        })
+    };
+    result.is_error = Some(outcome != "acknowledged");
+    result.with_structured(content)
+}
