+//! Normal set_value replies and retries against fault-controlled private AT-SPI.
+#![cfg(target_os = "linux")]
+use platform_linux::atspi::{
+    native::ObjectRef, set_value_token, snapshot::CachedElement, AtspiIdentity, TokenElement,
+};
+use std::io::BufRead;
+use std::process::{Child, Command, Stdio};
+use std::sync::{Arc, Mutex};
+
+const SERVICE: &str = "org.cua.SetValueFixture";
+const OBJECT: &str = "/org/a11y/atspi/accessible/entry";
+#[derive(Clone, Default)]
+struct Counts {
+    setters: usize,
+    effects: usize,
+    inserts: usize,
+    activates: usize,
+    values: usize,
+    resolutions: usize,
+}
+struct Bus {
+    child: Child,
+    _directory: tempfile::TempDir,
+}
+impl Drop for Bus {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+struct A11yBus(String);
+#[zbus::interface(name = "org.a11y.Bus")]
+impl A11yBus {
+    fn get_address(&self) -> String {
+        self.0.clone()
+    }
+}
+struct Accessible;
+#[zbus::interface(name = "org.a11y.atspi.Accessible")]
+impl Accessible {
+    fn get_role_name(&self) -> String {
+        "text".into()
+    }
+    fn get_interfaces(&self) -> Vec<String> {
+        ["Accessible", "EditableText", "Text", "Action", "Value"]
+            .into_iter()
+            .map(|name| format!("org.a11y.atspi.{name}"))
+            .collect()
+    }
+}
+struct Registry(Arc<Mutex<Counts>>);
+#[zbus::interface(name = "org.a11y.atspi.Accessible")]
+impl Registry {
+    fn get_children(&self) -> Vec<(String, zbus::zvariant::OwnedObjectPath)> {
+        self.0.lock().unwrap().resolutions += 1;
+        Vec::new()
+    }
+}
+struct Editable(Arc<Mutex<Counts>>);
+#[zbus::interface(name = "org.a11y.atspi.EditableText")]
+impl Editable {
+    async fn set_text_contents(&self, text: &str) -> zbus::fdo::Result<bool> {
+        {
+            let mut count = self.0.lock().unwrap();
+            count.setters += 1;
+            if !matches!(text, "explicit-false" | "insert-error-after-effect") {
+                count.effects += 1;
+            }
+        }
+        match text {
+            "explicit-false" | "insert-error-after-effect" => Ok(false),
+            "error-after-effect" => Err(zbus::fdo::Error::Failed(
+                "fixture applied before its error".into(),
+            )),
+            "timeout-after-effect" => {
+                tokio::time::sleep(std::time::Duration::from_secs(10)).await;
+                Ok(true)
+            }
+            _ => Ok(true),
+        }
+    }
+    fn insert_text(&self, _position: i32, text: &str, _length: i32) -> zbus::fdo::Result<bool> {
+        let mut counts = self.0.lock().unwrap();
+        counts.inserts += 1;
+        counts.effects += 1;
+        if text == "insert-error-after-effect" {
+            Err(zbus::fdo::Error::Failed(
+                "fixture insert applied before its error".into(),
+            ))
+        } else {
+            Ok(true)
+        }
+    }
+}
+struct Text;
+#[zbus::interface(name = "org.a11y.atspi.Text")]
+impl Text {
+    #[zbus(property)]
+    fn caret_offset(&self) -> i32 {
+        0
+    }
+}
+struct Action(Arc<Mutex<Counts>>);
+#[zbus::interface(name = "org.a11y.atspi.Action")]
+impl Action {
+    #[zbus(property, name = "NActions")]
+    fn n_actions(&self) -> i32 {
+        1
+    }
+    fn get_name(&self, _index: i32) -> String {
+        "activate".into()
+    }
+    fn do_action(&self, _index: i32) -> bool {
+        self.0.lock().unwrap().activates += 1;
+        true
+    }
+}
+struct NumericValue(Arc<Mutex<Counts>>);
+#[zbus::interface(name = "org.a11y.atspi.Value")]
+impl NumericValue {
+    #[zbus(property)]
+    fn current_value(&self) -> f64 {
+        0.0
+    }
+    #[zbus(property)]
+    fn set_current_value(&self, _value: f64) {
+        self.0.lock().unwrap().values += 1;
+    }
+}
