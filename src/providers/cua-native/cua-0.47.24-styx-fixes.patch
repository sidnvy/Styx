+struct Action(Arc<Mutex<Counts>>);
+#[zbus::interface(name = "org.a11y.atspi.Action")]
+impl Action {
+    #[zbus(property, name = "NActions")]
+    fn n_actions(&self) -> i32 {
+        1
+    }
+    fn get_name(&self, _index: i32) -> String {
+        "activate".into()
+    }
+    fn do_action(&self, _index: i32) -> bool {
+        self.0.lock().unwrap().activates += 1;
+        true
+    }
+}
+struct NumericValue(Arc<Mutex<Counts>>);
+#[zbus::interface(name = "org.a11y.atspi.Value")]
