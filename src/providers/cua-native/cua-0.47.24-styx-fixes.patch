+/// Plan the whole replacement before selection is emitted, using the same
+/// keymap and Unicode planner as typing. Empty text clears the selection.
+fn plan_replacement_text(xkb: &Xkb1, map: &str, group: u32, text: &str) -> Result<Vec<Part>> {
+    let mut parts = plan_text(xkb, map, group, text)?;
+    if text.is_empty() {
+        return Ok(vec![Part {
+            keys: vec![
+                plan_key(xkb, map, group, &["ctrl".into()], "a")?,
+                plan_key(xkb, map, group, &[], "BackSpace")?,
+            ],
+            extended: None,
+        }]);
+    }
+    let first = parts.first_mut().context("nonempty text has no key plan")?;
+    // Selection must be the first key under the text's keymap, just as the
+    // first character is for type_text. Do not send a base-map key first.
+    let select_all = plan_key(
+        xkb,
+        first.extended.as_deref().unwrap_or(map),
+        group,
+        &["ctrl".into()],
+        "a",
+    )?;
+    first.keys.insert(0, select_all);
+    Ok(parts)
 }
 
