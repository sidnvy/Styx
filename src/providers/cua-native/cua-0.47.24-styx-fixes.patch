+/// Result of the strict text-only route. Refused is reserved for validation
+/// that completed before the one native setter was polled.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum StrictTextOutcome {
+    Refused(&'static str),
+    Acknowledged,
+    Unknown,
+}
+
+/// One SetTextContents on the cached snapshot object. Never re-resolve an
+/// ordinal, insert text, set a numeric Value, activate, or retry after failure.
+pub fn set_text_ref_strict(object_ref: &ObjectRef, value: &str) -> StrictTextOutcome {
+    bounded_for(
+        REF_ACTION_BUDGET,
+        async {
+            let conn = match shared_connection().await {
+                Ok(conn) => conn,
+                Err(_) => return Ok(StrictTextOutcome::Refused("strict_text_unavailable")),
+            };
+            let (acc, _) = match live_accessible(conn, object_ref).await {
+                Ok(accessible) => accessible,
+                Err(_) => return Ok(StrictTextOutcome::Refused("stale_observation")),
+            };
+            let proxies = match acc.proxies().await {
+                Ok(proxies) => proxies,
+                Err(_) => return Ok(StrictTextOutcome::Refused("editable_unavailable")),
+            };
+            let editable = match proxies.editable_text().await {
+                Ok(editable) => editable,
+                Err(_) => return Ok(StrictTextOutcome::Refused("editable_unavailable")),
+            };
+            if deadline_passed() {
+                return Ok(StrictTextOutcome::Refused("stale_observation"));
+            }
+            // From the first setter poll onward, false/error/timeout is
+            // Unknown: an application may have changed before its reply failed.
+            Ok(match call(editable.set_text_contents(value)).await {
+                Some(Ok(true)) => StrictTextOutcome::Acknowledged,
+                _ => StrictTextOutcome::Unknown,
+            })
+        },
+        || Ok(StrictTextOutcome::Unknown),
+    )
+    .unwrap_or(StrictTextOutcome::Unknown)
+}
