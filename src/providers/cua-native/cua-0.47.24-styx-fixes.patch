+/// Focus an exact compositor address only after binding it to the expected PID.
+/// Uses ordinary Hyprland IPC once, not the optional isolated-input plugin.
+pub fn activate_exact(address: u64, pid: u32) -> Result<()> {
+    capture_target(&list_windows()?, address, Some(pid))?;
+    if target_is_active(address, Some(pid))? {
+        return Ok(());
+    }
+    let mut ipc = ipc_connection()?;
+    let command = format!("/dispatch hl.dsp.focus({{ window = \"address:0x{address:x}\" }})");
+    let reply = read_reply(&mut ipc, command.as_bytes(), action_capped(QUERY_TIMEOUT)?)?;
+    anyhow::ensure!(
+        reply.trim_ascii() == b"ok",
+        "Hyprland exact focus was refused: {}",
+        String::from_utf8_lossy(&reply)
+            .chars()
+            .take(256)
+            .collect::<String>()
+    );
+    anyhow::ensure!(
+        target_is_active(address, Some(pid))?,
+        "Hyprland exact focus was not confirmed"
+    );
+    Ok(())
