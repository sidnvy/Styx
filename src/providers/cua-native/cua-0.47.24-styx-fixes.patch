+}
+struct Accessible;
+#[zbus::interface(name = "org.a11y.atspi.Accessible")]
+impl Accessible {
+    fn get_role_name(&self) -> String {
+        "text".into()
+    }
+    fn get_interfaces(&self) -> Vec<String> {
+        ["Accessible", "EditableText", "Text", "Action", "Value"]
+            .into_iter()
+            .map(|name| format!("org.a11y.atspi.{name}"))
+            .collect()
+    }
+}
+struct Editable(Arc<Mutex<Counts>>);
+#[zbus::interface(name = "org.a11y.atspi.EditableText")]
+impl Editable {
+    async fn set_text_contents(&self, text: &str) -> zbus::fdo::Result<bool> {
+        {
+            let mut count = self.0.lock().unwrap();
+            count.setters += 1;
+            count.effects += 1;
+        }
+        match text {
+            "false-after-effect" => Ok(false),
+            "error-after-effect" => Err(zbus::fdo::Error::Failed(
+                "fixture applied before its error".into(),
+            )),
+            "timeout-after-effect" => {
+                tokio::time::sleep(std::time::Duration::from_secs(10)).await;
+                Ok(true)
+            }
+            _ => Ok(true),
+        }
+    }
+    fn insert_text(&self, _position: i32, _text: &str, _length: i32) -> bool {
+        self.0.lock().unwrap().inserts += 1;
+        true
+    }
