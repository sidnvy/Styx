+    #[test]
+    fn acknowledged_only_confirms_native_reply_not_visible_effect() {
+        let result = strict_text_result("acknowledged", None);
+        assert_eq!(result.is_error, Some(false));
+        assert_eq!(
+            result.structured_content,
+            Some(json!({
+                "schema":1,"outcome":"acknowledged","effect":"unverified"
+            }))
+        );
