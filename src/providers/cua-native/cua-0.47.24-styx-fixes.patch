+    #[test]
+    fn refused_and_unknown_have_distinct_closed_envelopes() {
+        let refused = strict_text_result("refused", Some("editable_unavailable"));
+        assert_eq!(refused.is_error, Some(true));
+        assert_eq!(
+            refused.structured_content,
+            Some(json!({
+                "schema":1,"outcome":"refused","effect":"unverified","code":"editable_unavailable"
+            }))
+        );
+        let unknown = strict_text_result("unknown", None);
+        assert_eq!(unknown.is_error, Some(true));
+        assert_eq!(
+            unknown.structured_content,
+            Some(json!({
+                "schema":1,"outcome":"unknown","effect":"unverified"
+            }))
+        );
+    }
+}
