+/// Use the same Unicode planner and bounded virtual-keyboard writer on an
+/// already connected compositor. The caller owns exact window/element focus;
+/// this entry invokes no niri IPC and checks that focus before each key.
+pub(in crate::wayland) fn type_text_on_connection(
+    connection: Connection,
+    text: &str,
+    replace: bool,
+    mut still_focused: impl FnMut(usize) -> Result<()>,
+) -> Result<()> {
+    let text = super::super::text_keys::typable_text(text)?;
+    if text.is_empty() && !replace {
+        return Ok(());
+    }
+    let keys = if replace {
+        text.chars().count().max(1) + 1
+    } else {
+        text.chars().count()
+    };
+    let deadline = session_deadline(
+        Instant::now(),
+        keys,
+        crate::input::action::current().map(|action| action.deadline()),
+    );
+    still_focused(0)?;
+    let mut keyboard = Keyboard::bind_connection(connection, deadline)?;
+    let mut sent = Sent::default();
+    let mut total = 0;
+    let typed = (|| {
+        let parts = if replace {
+            plan_replacement_text(xkb1()?, &keyboard.base.text, 0, &text)?
+        } else {
+            plan_text(xkb1()?, &keyboard.base.text, 0, &text)?
+        };
+        total = parts.iter().map(|part| part.keys.len()).sum();
+        type_parts(&mut keyboard, &parts, 0, deadline, &mut sent, still_focused)
+    })();
+    let finished = keyboard.finish(0);
+    outcome(sent, total, typed, finished)
+}
