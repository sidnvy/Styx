+impl Drop for Bus {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+struct A11yBus(String);
+#[zbus::interface(name = "org.a11y.Bus")]
+impl A11yBus {
+    fn get_address(&self) -> String {
+        self.0.clone()
