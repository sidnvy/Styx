+            args.get("editable_target").and_then(Value::as_str),
+            args.get("value").and_then(Value::as_str),
+        ) {
+            (Some(nonce), Some(value))
+                if nonce.len() == 64
+                    && nonce.bytes().all(|byte| byte.is_ascii_hexdigit())
+                    && value.len() <= 16 * 1024 =>
