+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[tokio::test]
+    async fn fence_waits_for_original_work_after_waiter_is_lost() {
+        let all = Transports::default();
+        all.claim_control("original").unwrap();
+        assert!(all.claim_control("original").is_err());
+        let mut call = all
+            .enter("original", Some("runtime:session".into()))
+            .unwrap();
+        let (finish, wait) = tokio::sync::oneshot::channel();
+        let work = tokio::spawn(async move {
+            let _ = wait.await;
+            call.settled();
+        });
+        let gate = all.close("original").unwrap();
+        assert!(all.enter("original", None).is_err());
+        assert!(
+            tokio::time::timeout(std::time::Duration::from_millis(10), gate.wait())
+                .await
+                .is_err()
+        );
+        // A drain waiter timing out never releases native-work custody.
+        assert!(all.claim_control("original").is_err());
+        finish.send(()).unwrap();
+        work.await.unwrap();
+        assert_eq!(gate.wait().await.unwrap(), vec!["runtime:session"]);
+        assert!(all.enter("original", None).is_err());
+    }
+    #[tokio::test]
+    async fn interrupted_work_remains_unknown_and_other_runtime_is_independent() {
+        let all = Transports::default();
+        all.claim_control("original").unwrap();
+        drop(all.enter("original", None).unwrap());
+        assert!(all.close("original").unwrap().wait().await.is_err());
+        let other_runtime = Transports::default();
+        other_runtime.claim_control("original").unwrap();
+        let mut call = other_runtime.enter("original", None).unwrap();
+        call.settled();
+        drop(call);
+        assert!(other_runtime
+            .close("original")
+            .unwrap()
+            .wait()
+            .await
+            .is_ok());
+    }
+}
