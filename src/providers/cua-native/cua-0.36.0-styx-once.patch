+impl State {
+    fn open(
+        pid: i32,
+        window: u64,
+        invalid: Arc<AtomicBool>,
+        deadline: Instant,
+    ) -> NativeResult<Self> {
+        let binding = WindowBinding::open(pid, window)?;
+        let automation: IUIAutomation =
+            unsafe { CoCreateInstance(&CUIAutomation8, None, CLSCTX_INPROC_SERVER) }
+                .map_err(|_| "editable_unavailable")?;
+        let timeouts = automation
+            .cast::<IUIAutomation2>()
+            .map_err(|_| "editable_unavailable")?;
+        budget(&timeouts, deadline)?;
+        unsafe { timeouts.SetAutoSetFocus(false) }.map_err(|_| "editable_unavailable")?;
+        let root = unsafe { automation.ElementFromHandle(HWND(window as usize as *mut _)) }
+            .map_err(|_| "window_unavailable")?;
+        let walker = unsafe { automation.RawViewWalker() }.map_err(|_| "object_unavailable")?;
+        let properties: IUIAutomationPropertyChangedEventHandler = Invalidator {
+            invalid: invalid.clone(),
+        }
+        .into();
+        let structure = properties.cast().map_err(|_| "object_unavailable")?;
+        let mut state = Self {
+            automation,
+            timeouts,
+            root,
+            walker,
+            properties,
+            structure,
+            properties_added: false,
+            structure_added: false,
+            binding,
+            invalid,
+            elements: Vec::new(),
+            values: Vec::new(),
+            pending: None,
+            sequence: 0,
+            captured: Instant::now(),
+        };
+        budget(&state.timeouts, deadline)?;
+        unsafe {
+            state.automation.AddPropertyChangedEventHandlerNativeArray(
+                &state.root,
+                TreeScope_Subtree,
+                None,
+                &state.properties,
+                &[
+                    UIA_ValueValuePropertyId,
+                    UIA_IsEnabledPropertyId,
+                    UIA_IsPasswordPropertyId,
+                    UIA_ControlTypePropertyId,
+                    UIA_BoundingRectanglePropertyId,
+                    UIA_NamePropertyId,
+                    UIA_IsOffscreenPropertyId,
+                ],
+            )
+        }
+        .map_err(|_| "observer_unavailable")?;
+        state.properties_added = true;
+        budget(&state.timeouts, deadline)?;
+        unsafe {
+            state.automation.AddStructureChangedEventHandler(
+                &state.root,
+                TreeScope_Subtree,
+                None,
+                &state.structure,
+            )
+        }
+        .map_err(|_| "observer_unavailable")?;
+        state.structure_added = true;
+        state.verify(deadline)?;
+        Ok(state)
+    }
+    fn verify(&self, deadline: Instant) -> NativeResult<()> {
+        if self.invalid.load(Ordering::Acquire) {
+            return Err("target_invalidated");
+        }
+        if self.captured.elapsed() >= Duration::from_secs(30) {
+            return Err("target_expired");
+        }
+        self.binding.verify()?;
+        budget(&self.timeouts, deadline)?;
+        let current = unsafe { self.automation.ElementFromHandle(self.binding.hwnd()) }
+            .map_err(|_| "window_unavailable")?;
+        if !unsafe { self.automation.CompareElements(&current, &self.root) }
+            .map_err(|_| "object_unavailable")?
+            .as_bool()
+        {
+            return Err("window_changed");
+        }
+        if unsafe { self.root.CurrentProcessId() }.map_err(|_| "object_unavailable")?
+            != self.binding.pid()
+        {
+            return Err("unproven_object_owner");
+        }
+        budget(&self.timeouts, deadline)?;
+        if self.invalid.load(Ordering::Acquire) {
+            return Err("target_invalidated");
+        }
+        Ok(())
+    }
+    fn collect(
+        &mut self,
+        limit: usize,
+        max_depth: usize,
+        deadline: Instant,
+    ) -> NativeResult<Vec<Value>> {
+        let mut stack = vec![(self.root.clone(), 0usize, None::<usize>)];
+        let mut rows = Vec::new();
+        while let Some((element, depth, parent)) = stack.pop() {
+            budget(&self.timeouts, deadline)?;
+            if self.invalid.load(Ordering::Acquire) {
+                return Err("target_invalidated");
+            }
+            if rows.len() >= limit || depth > max_depth {
+                return Err("stale_observation");
+            }
+            for old in &self.elements {
+                if unsafe { self.automation.CompareElements(old, &element) }
+                    .map_err(|_| "object_unavailable")?
+                    .as_bool()
+                {
+                    return Err("stale_observation");
+                }
+                budget(&self.timeouts, deadline)?;
+            }
+            if unsafe { element.CurrentProcessId() }.map_err(|_| "object_unavailable")?
+                != self.binding.pid()
+            {
+                return Err("unproven_object_owner");
+            }
+            let role = unsafe { element.CurrentControlType() }.map_err(|_| "object_unavailable")?;
+            budget(&self.timeouts, deadline)?;
+            let secret = unsafe { element.CurrentIsPassword() }
+                .map_err(|_| "object_unavailable")?
+                .as_bool();
+            budget(&self.timeouts, deadline)?;
+            let label = text(unsafe { element.CurrentName() }.map_err(|_| "object_unavailable")?)?;
+            budget(&self.timeouts, deadline)?;
+            let enabled = unsafe { element.CurrentIsEnabled() }
+                .map_err(|_| "object_unavailable")?
+                .as_bool();
+            let value = if role == UIA_EditControlTypeId && !secret {
+                budget(&self.timeouts, deadline)?;
+                let pattern = unsafe {
+                    element.GetCurrentPatternAs::<IUIAutomationValuePattern>(UIA_ValuePatternId)
+                }
+                .map_err(|_| "editable_unavailable")?;
+                budget(&self.timeouts, deadline)?;
+                Some(text(
+                    unsafe { pattern.CurrentValue() }.map_err(|_| "object_unavailable")?,
+                )?)
+            } else {
+                None
+            };
+            let index = rows.len();
+            let mut row = json!({"element_index":index,"role":super::control_type_name(role.0),"label":label,"depth":depth,"enabled":enabled,"password":secret});
+            if let Some(parent) = parent {
+                row["parent_index"] = json!(parent);
+            }
+            if let Some(value) = &value {
+                row["value"] = json!(value);
+            }
+            let mut children = Vec::new();
+            budget(&self.timeouts, deadline)?;
+            let mut next = relative(&self.walker, &element, true)?;
+            while let Some(child) = next {
+                if rows.len() + stack.len() + children.len() + 1 >= limit || depth == max_depth {
+                    return Err("stale_observation");
+                }
+                budget(&self.timeouts, deadline)?;
+                next = relative(&self.walker, &child, false)?;
+                children.push(child);
+            }
+            for child in children.into_iter().rev() {
+                stack.push((child, depth + 1, Some(index)));
+            }
+            self.elements.push(element);
+            self.values.push(value);
+            rows.push(row);
+        }
+        if rows.is_empty()
+            || serde_json::to_vec(&rows)
+                .map_err(|_| "stale_observation")?
+                .len()
+                > 256 * 1024
+        {
+            return Err("stale_observation");
+        }
+        self.verify(deadline)?;
+        Ok(rows)
+    }
+    fn belongs_to_original_window(
+        &self,
+        element: &IUIAutomationElement,
+        deadline: Instant,
+    ) -> NativeResult<()> {
+        let mut current = element.clone();
+        for _ in 0..=64 {
+            budget(&self.timeouts, deadline)?;
+            if unsafe { self.automation.CompareElements(&current, &self.root) }
+                .map_err(|_| "object_unavailable")?
+                .as_bool()
+            {
+                return Ok(());
+            }
+            budget(&self.timeouts, deadline)?;
+            let mut raw = std::ptr::null_mut();
+            let result = unsafe {
+                (Interface::vtable(&self.walker).GetParentElement)(
+                    self.walker.as_raw(),
+                    current.as_raw(),
+                    &mut raw,
+                )
+            };
+            if result != windows::core::HRESULT(0) {
+                if !raw.is_null() {
+                    drop(unsafe { IUIAutomationElement::from_raw(raw) });
+                }
+                return Err("object_unavailable");
+            }
+            if raw.is_null() {
+                return Err("object_frame_mismatch");
+            }
+            current = unsafe { IUIAutomationElement::from_raw(raw) };
+        }
+        Err("object_frame_mismatch")
+    }
+    fn editable(&self, row: usize, deadline: Instant) -> NativeResult<IUIAutomationValuePattern> {
+        self.verify(deadline)?;
+        let element = self.elements.get(row).ok_or("stale_observation")?;
+        self.belongs_to_original_window(element, deadline)?;
+        let expected = self
+            .values
+            .get(row)
+            .and_then(Option::as_ref)
+            .ok_or("editable_unavailable")?;
+        budget(&self.timeouts, deadline)?;
+        unsafe {
+            if element
+                .CurrentControlType()
+                .map_err(|_| "object_unavailable")?
+                != UIA_EditControlTypeId
+                || element
+                    .CurrentIsPassword()
+                    .map_err(|_| "object_unavailable")?
+                    .as_bool()
+                || !element
+                    .CurrentIsEnabled()
+                    .map_err(|_| "object_unavailable")?
+                    .as_bool()
+                || element
+                    .CurrentProcessId()
+                    .map_err(|_| "object_unavailable")?
+                    != self.binding.pid()
+            {
+                return Err("editable_unavailable");
+            }
+            let pattern = element
+                .GetCurrentPatternAs::<IUIAutomationValuePattern>(UIA_ValuePatternId)
+                .map_err(|_| "editable_unavailable")?;
+            if pattern
+                .CurrentIsReadOnly()
+                .map_err(|_| "object_unavailable")?
+                .as_bool()
+                || text(pattern.CurrentValue().map_err(|_| "object_unavailable")?)? != *expected
+            {
+                return Err("target_identity_changed");
+            }
+            self.verify(deadline)?;
+            Ok(pattern)
+        }
+    }
+}
+enum Command {
+    Acquire {
+        row: usize,
+        pointer: usize,
+        reply: mpsc::SyncSender<NativeResult<u64>>,
+    },
+    Write {
+        sequence: u64,
+        value: zeroize::Zeroizing<String>,
+        reply: mpsc::SyncSender<WriteOutcome>,
+    },
+}
+struct Worker {
+    invalid: Arc<AtomicBool>,
+    stop: Arc<AtomicBool>,
+    commands: mpsc::SyncSender<Command>,
+    thread: Option<thread::JoinHandle<()>>,
+}
+impl Drop for Worker {
+    fn drop(&mut self) {
+        self.invalid.store(true, Ordering::Release);
+        self.stop.store(true, Ordering::Release);
+        if let Some(thread) = self.thread.take() {
+            let _ = thread.join();
+        }
+    }
+}
+pub(crate) struct CompleteSnapshot {
+    pub(crate) pid: i32,
+    pub(crate) window_id: u64,
