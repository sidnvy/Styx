+struct StyxAcquireEditableTool { state: Arc<ToolState> }
+static STYX_ACQUIRE_EDITABLE_DEF: std::sync::OnceLock<ToolDef> = std::sync::OnceLock::new();
+#[async_trait]
+impl Tool for StyxAcquireEditableTool {
+    fn def(&self) -> &ToolDef {
+        STYX_ACQUIRE_EDITABLE_DEF.get_or_init(|| ToolDef {
+            name:"styx_private_ax_acquire_editable_v1".into(),
+            description:"Private owned-transport exact snapshot EditableText target acquisition; no OS write authorization is granted.".into(),
+            input_schema:json!({"type":"object","required":["pid","window_id","element_token"],
+                "properties":{"pid":{"type":"integer","minimum":1,"maximum":4294967295u64},
+                "window_id":{"type":"integer","minimum":1},"element_token":{"type":"string","maxLength":64}},
+                "additionalProperties":false}),
+            read_only:true,destructive:false,idempotent:false,open_world:false,
+        })
+    }
+    async fn invoke(&self, args: Value) -> ToolResult {
+        let (transport, session, lifecycle) = match styx_private_lifecycle(&args) { Ok(v)=>v,Err(e)=>return e };
+        let (pid, window, token) = match (
+            args.get("pid").and_then(Value::as_u64).and_then(|v|u32::try_from(v).ok()),
+            args.get("window_id").and_then(Value::as_u64),
+            args.get("element_token").and_then(Value::as_str),
+        ) { (Some(p),Some(w),Some(t)) if p>0 && p<=i32::MAX as u32 && w>0 && t.len()<=64 => (p,w,t.to_owned()),
+            _=>return styx_private_result("invalid_request","not_dispatched") };
+        let Some((snapshot_id, row)) = cua_driver_core::element_token::parse_token(&token) else {
+            return styx_private_result("full_snapshot_token_required","not_dispatched");
+        };
+        if snapshot_id == 0 || row >= 2048
+            || cua_driver_core::element_token::token_for(snapshot_id,row) != token {
+            return styx_private_result("full_snapshot_token_required","not_dispatched");
+        }
+        // New acquisition retires the previous slot before any await. A slow
+        // older acquisition cannot install after a newer acquire/write call.
+        let revision = {
+            let mut slot = match self.state.styx_once.lock() { Ok(v)=>v,Err(_)=>return styx_private_result("target_cache_unavailable","not_dispatched") };
+            slot.pending.take();
+            let Some(next) = slot.revision.checked_add(1) else { return styx_private_result("target_cache_exhausted","not_dispatched"); };
+            slot.revision=next; next
+        };
+        let element = match self.state.snapshots.resolve(pid as i32, &args) {
+            Ok(cua_driver_core::element_token::ResolvedElement::Element { window_id, element_index, element })
+                if window_id == window && element_index == row => element,
+            _=>return styx_private_result("stale_observation","not_dispatched"),
+        };
+        let Some(event_epoch) = element.styx_event_epoch
+            .filter(|value| crate::atspi::native::styx_event_epoch_matches(*value)) else {
+            return styx_private_result("stale_observation","not_dispatched");
+        };
+        let Some(object) = element.object_ref else { return styx_private_result("unproven_object_identity","not_dispatched"); };
+        let identity = element.identity;
+        let retained_identity = identity.clone();
+        let mut random = [0u8;32];
+        if getrandom::fill(&mut random).is_err() { return styx_private_result("entropy_unavailable","not_dispatched"); }
+        let nonce = random.iter().map(|b|format!("{b:02x}")).collect::<String>();
+        let job = tokio::task::spawn_blocking(move || {
+            let _lifecycle=lifecycle;
+            crate::atspi::native::styx_acquire_editable(pid,window,identity,object,event_epoch)
+        });
+        let target = match job.await {
+            Ok(Ok(target))=>target,
+            Ok(Err(code))=>return styx_private_result(code,"not_dispatched"),
+            Err(_)=>return styx_private_result("acquisition_worker_failed","not_dispatched"),
+        };
+        let mut slot = match self.state.styx_once.lock() { Ok(v)=>v,Err(_)=>return styx_private_result("target_cache_unavailable","not_dispatched") };
+        if slot.revision != revision || !crate::atspi::native::styx_event_epoch_matches(event_epoch) {
+            return styx_private_result("stale_observation","not_dispatched");
+        }
+        slot.pending=Some(StyxPendingEditable {
+            nonce:nonce.clone(),transport,session,pid,window,native_token:token,
+            identity:retained_identity,event_epoch,target,
+        });
+        ToolResult::text("private_target_acquired").with_structured(json!({
+            "schema":1,"target":nonce,"pid":pid,"window_id":window,
+            "snapshot_id":cua_driver_core::element_token::format_snapshot_id(snapshot_id),"element_index":row
+        }))
+    }
+}
