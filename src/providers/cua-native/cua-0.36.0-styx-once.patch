+fn result(code: &'static str, certainty: &'static str) -> ToolResult {
+    ToolResult::error(code).with_structured(json!({"schema":1,"code":code,"execution_certainty":certainty,"uncertain":certainty == "unknown"}))
+}
+fn refusal(code: &'static str) -> ToolResult {
+    result(code, "not_dispatched")
+}
+fn lifecycle(
+    args: &Value,
+) -> Result<
+    (
+        String,
+        String,
+        cua_driver_core::session::SessionDispatchGuard,
+    ),
+    ToolResult,
+> {
+    let transport = args
+        .get("_transport_session_id")
+        .and_then(Value::as_str)
+        .ok_or_else(|| refusal("transport_required"))?;
+    let session = args
+        .get("_session_id")
+        .and_then(Value::as_str)
+        .ok_or_else(|| refusal("transport_required"))?;
+    let snapshot = cua_driver_core::session::session_snapshot(session, transport, Duration::ZERO)
+        .ok_or_else(|| refusal("lifecycle_unavailable"))?;
+    let guard = cua_driver_core::session::begin_session_dispatch(
+        session,
+        snapshot.public_label.as_deref(),
+        transport,
+        snapshot.implicit,
+        snapshot.transport,
+        snapshot.client_kind,
+    )
+    .map_err(|_| refusal("lifecycle_unavailable"))?;
+    Ok((transport.to_owned(), session.to_owned(), guard))
+}
+/// Exact existing runtime tree-only request. Other native Cua read modes retain
+/// their original actionable-tree semantics and never claim completeness here.
+pub(crate) fn is_complete_request(args: &Value) -> bool {
+    let Some(object) = args.as_object() else {
+        return false;
+    };
+    args.get("include_screenshot").and_then(Value::as_bool) == Some(false)
+        && args
+            .get("include_accessibility_tree")
+            .and_then(Value::as_bool)
+            == Some(true)
+        && args.get("tree_format").and_then(Value::as_str) == Some("elements")
+        && args
+            .get("max_elements")
+            .and_then(Value::as_u64)
+            .is_some_and(|value| (1..=2048).contains(&value))
+        && args
+            .get("max_depth")
+            .and_then(Value::as_u64)
+            .is_some_and(|value| (1..=64).contains(&value))
+        && args
+            .get("timeout_ms")
+            .and_then(Value::as_u64)
+            .is_some_and(|value| (100..=2000).contains(&value))
+        && object.keys().all(|key| {
+            matches!(
+                key.as_str(),
+                "pid"
+                    | "window_id"
+                    | "include_screenshot"
+                    | "include_accessibility_tree"
+                    | "tree_format"
+                    | "max_elements"
+                    | "max_depth"
+                    | "timeout_ms"
+                    | "session"
+                    | "_session_id"
+                    | "_transport_session_id"
+                    | "_public_session_label"
+                    | "_session_idle_ttl_ms"
+            )
+        })
+}
+fn incomplete(code: &'static str) -> ToolResult {
+    ToolResult::error(code).with_structured(json!({
+        "schema":1,"code":code,"execution_certainty":"not_dispatched","uncertain":false,
+        "elements_complete":false,"degraded":true
+    }))
+}
