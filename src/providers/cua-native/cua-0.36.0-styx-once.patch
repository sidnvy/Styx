+#[derive(Default)]
+pub(crate) struct PrivateAx {
+    slot: Mutex<Slot>,
+}
+impl Slot {
+    fn advance(&mut self) -> Result<u64, ToolResult> {
+        self.revision = self
+            .revision
+            .checked_add(1)
+            .ok_or_else(|| refusal("target_cache_exhausted"))?;
+        Ok(self.revision)
+    }
+    fn retire_snapshot(&mut self) -> (Option<CachedSnapshot>, Option<Pending>) {
+        let snapshot = self.snapshot.take();
+        if let Some(snapshot) = &snapshot {
+            snapshot.native.invalidate();
+        }
+        (snapshot, self.pending.take())
+    }
+}
+impl PrivateAx {
+    pub(crate) fn retire(&self, session: Option<&str>) {
+        // This upstream lifecycle callback is synchronous. Keep its real join
+        // semantics, but never wait for COM teardown while holding the slot.
+        let retired = {
+            let mut slot = self.slot.lock().unwrap_or_else(|error| error.into_inner());
+            if session.is_none()
+                || slot
+                    .snapshot
+                    .as_ref()
+                    .is_some_and(|snapshot| Some(snapshot.session.as_str()) == session)
+            {
+                let retired = slot.retire_snapshot();
+                let _ = slot.advance();
+                Some(retired)
+            } else {
+                None
+            }
+        };
+        // Last native reference may synchronously join the original MTA here.
+        // Direct worker Job teardown remains the hard physical boundary if COM
+        // cannot finish; this callback does not claim a bounded async join.
+        drop(retired);
+    }
+}
+impl Drop for PrivateAx {
+    fn drop(&mut self) {
+        self.retire(None);
+    }
+}
