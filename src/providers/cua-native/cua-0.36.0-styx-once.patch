+    NotDispatched(&'static str),
+    Unknown,
+}
+
+fn styx_boot() -> std::result::Result<String, &'static str> {
+    let boot = std::fs::read_to_string("/proc/sys/kernel/random/boot_id")
+        .map_err(|_| "process_unavailable")?;
+    if boot.len() != 37 || !boot.trim().bytes().all(|b| b.is_ascii_hexdigit() || b == b'-') {
+        return Err("process_unavailable");
+    }
+    Ok(boot)
+}
+
+fn styx_same_window(a: &crate::wayland::hyprland::Window, b: &crate::wayland::hyprland::Window) -> bool {
+    a.address == b.address && a.pid == b.pid && a.title == b.title
+        && a.app_id == b.app_id && a.x == b.x && a.y == b.y
+        && a.width == b.width && a.height == b.height
+        && b.visible && b.xwayland == Some(false)
+}
+
+async fn styx_owner_pid(connection: &AccessibilityConnection, owner: &str) -> std::result::Result<u32, &'static str> {
+    // No well-known-name resolution and no caller-supplied bus locator.
+    let name = atspi::zbus::names::UniqueName::try_from(owner.to_owned())
+        .map_err(|_| "unproven_object_owner")?;
+    let bus = atspi::zbus::fdo::DBusProxy::new(connection.connection()).await
+        .map_err(|_| "bus_unavailable")?;
+    bus.get_connection_unix_process_id(name.into()).await.map_err(|_| "object_owner_gone")
+}
+
+async fn styx_validate_target(target: &StyxEditableTarget) -> std::result::Result<(), &'static str> {
+    if !styx_event_epoch_matches(target.event_epoch) {
+        return Err("target_invalidated");
+    }
+    if std::time::Instant::now() >= target.expires {
+        return Err("target_expired");
+    }
+    let connection = shared_connection().await.map_err(|_| "bus_unavailable")?;
+    if !std::ptr::eq(connection, target.connection)
+        || connection.connection().server_guid().to_string() != target.bus_guid
+        || styx_boot()? != target.boot
+        || crate::proc_fs::process_instance_id(target.pid) != Some(target.birth)
+        || styx_owner_pid(connection, &target.identity.bus_name).await? != target.pid
+        || styx_owner_pid(connection, &target.identity.frame_bus_name).await? != target.pid
+    {
+        return Err("target_identity_changed");
+    }
+    let window = crate::wayland::hyprland::accessibility_window(target.window.address, target.pid)
+        .ok_or("window_unavailable")?;
+    if !styx_same_window(&target.window, &window) { return Err("window_changed"); }
+    let frame = accessible_via_bus(connection, &RawObjectRef {
+        name: target.identity.frame_bus_name.clone(), path: target.identity.frame_path.clone(),
+    }).await.map_err(|_| "frame_unavailable")?;
+    let title = frame.name().await.map_err(|_| "frame_unavailable")?;
+    let role = frame.get_role_name().await.map_err(|_| "frame_unavailable")?;
+    if title != window.title || !matches!(role.to_lowercase().as_str(), "frame" | "window" | "dialog") {
+        return Err("frame_window_mismatch");
+    }
+    // Follow only this already selected object's ancestors. Never enumerate
+    // children, re-resolve an ordinal, or search for a replacement object.
+    let mut current = RawObjectRef { name: target.object.bus.clone(), path: target.object.path.clone() };
+    let mut visited = std::collections::HashSet::new();
+    let mut reached_frame = false;
+    for _ in 0..64 {
+        if current.name == target.identity.frame_bus_name && current.path == target.identity.frame_path {
+            reached_frame = true; break;
+        }
+        if current.name != target.identity.bus_name || !visited.insert(current.path.clone()) {
+            return Err("object_frame_mismatch");
+        }
+        let proxy = atspi::zbus::proxy::Builder::<atspi::zbus::Proxy<'_>>::new(connection.connection())
+            .cache_properties(atspi::zbus::proxy::CacheProperties::No)
+            .destination(current.name.clone()).map_err(|_| "object_unavailable")?
+            .path(current.path.clone()).map_err(|_| "object_unavailable")?
+            .interface("org.a11y.atspi.Accessible").map_err(|_| "object_unavailable")?
+            .build().await.map_err(|_| "object_unavailable")?;
+        let (owner, path): (String, atspi::zbus::zvariant::OwnedObjectPath) = proxy
+            .get_property("Parent").await.map_err(|_| "object_unavailable")?;
+        if owner != target.identity.bus_name { return Err("object_frame_mismatch"); }
+        current = RawObjectRef { name: owner, path: path.to_string() };
+    }
+    if !reached_frame { return Err("object_frame_mismatch"); }
+    let accessible = accessible_via_bus(connection, &RawObjectRef {
+        name: target.object.bus.clone(), path: target.object.path.clone(),
+    }).await.map_err(|_| "object_unavailable")?;
+    let states = accessible.get_state().await.map_err(|_| "object_unavailable")?;
+    if states.contains(State::Defunct) { return Err("object_defunct"); }
+    if !accessible.get_interfaces().await.map_err(|_| "object_unavailable")?.contains(Interface::EditableText) {
+        return Err("editable_unavailable");
+    }
+    if std::time::Instant::now() >= target.expires
+        || !styx_event_epoch_matches(target.event_epoch)
+        || crate::proc_fs::process_instance_id(target.pid) != Some(target.birth)
+    { return Err("target_identity_changed"); }
+    Ok(())
+}
+
+pub(crate) fn styx_acquire_editable(
+    pid: u32, window_id: u64, identity: AtspiIdentity, object: ObjectRef, event_epoch: u64,
+) -> std::result::Result<StyxEditableTarget, &'static str> {
+    if !styx_event_epoch_matches(event_epoch) { return Err("target_invalidated"); }
+    if pid == 0 || pid == std::process::id() || window_id == 0
+        || identity.bus_name != object.bus || identity.path != object.path
+        || identity.bus_name != identity.frame_bus_name
+        || identity.path.len() > 4096 || identity.frame_path.len() > 4096
+        || identity.bus_name.len() > 255
+    { return Err("unproven_object_identity"); }
+    let expires = std::time::Instant::now() + Duration::from_secs(30);
+    let birth = crate::proc_fs::process_instance_id(pid).ok_or("process_unavailable")?;
+    let boot = styx_boot()?;
+    // Narrow first slice: native Hyprland same-process EditableText. No X11,
+    // WebProcess, title-prefix or cross-process accessibility fallback.
+    let window = crate::wayland::hyprland::accessibility_window(window_id, pid)
+        .filter(|w| w.visible && w.xwayland == Some(false)).ok_or("window_unavailable")?;
+    runtime().block_on(async {
+        tokio::time::timeout(Duration::from_secs(3), async {
+            let connection = shared_connection().await.map_err(|_| "bus_unavailable")?;
+            let editable = atspi::zbus::proxy::Builder::<atspi::zbus::Proxy<'static>>::new(connection.connection())
+                .cache_properties(atspi::zbus::proxy::CacheProperties::No)
+                .destination(object.bus.clone()).map_err(|_| "object_unavailable")?
+                .path(object.path.clone()).map_err(|_| "object_unavailable")?
+                .interface("org.a11y.atspi.EditableText").map_err(|_| "object_unavailable")?
+                .build().await.map_err(|_| "object_unavailable")?;
+            let target = StyxEditableTarget {
+                connection, editable, object, identity, pid, birth, boot, window,
+                bus_guid: connection.connection().server_guid().to_string(), expires, event_epoch,
+            };
+            styx_validate_target(&target).await?;
+            Ok(target)
+        }).await.unwrap_or(Err("acquisition_timeout"))
+    })
+}
+
+/// Consumes the non-Clone target. No insert/Value/Selection/activate fallback.
+/// Timeout ends only our wait; the protected application may still complete
+/// the original request. The shared bus stays alive and the caller reports
+/// Unknown rather than claiming cancellation or retrying the native method.
+pub(crate) fn styx_set_text_once(target: StyxEditableTarget, value: zeroize::Zeroizing<String>) -> StyxWriteOutcome {
+    if value.len() > 16 * 1024 { return StyxWriteOutcome::NotDispatched("value_too_large"); }
+    runtime().block_on(async {
+        match tokio::time::timeout(Duration::from_secs(3), styx_validate_target(&target)).await {
+            Ok(Ok(())) => {},
+            Ok(Err(code)) => return StyxWriteOutcome::NotDispatched(code),
+            Err(_) => return StyxWriteOutcome::NotDispatched("validation_timeout"),
+        }
+        // Last local expiry check and the single method dispatch have no
+        // intervening await. Remote revocation after send cannot retract it.
+        if !styx_event_epoch_matches(target.event_epoch) {
+            return StyxWriteOutcome::NotDispatched("target_invalidated");
+        }
+        if std::time::Instant::now() >= target.expires {
+            return StyxWriteOutcome::NotDispatched("target_expired");
+        }
+        let result = tokio::time::timeout(Duration::from_secs(3), async {
+            let reply: atspi::zbus::Result<bool> = target.editable.call("SetTextContents", &(value.as_str(),)).await;
+            reply
+        }).await;
+        match result {
+            Ok(Ok(true)) => StyxWriteOutcome::Acknowledged,
+            // False has no sufficiently strong no-effect contract. Errors and
+            // lost replies likewise never permit a second mutation route.
+            _ => StyxWriteOutcome::Unknown,
+        }
+    })
+}
