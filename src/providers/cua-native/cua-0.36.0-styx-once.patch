+//! Restricted Styx AX path. It retains original AX objects; it never relocates
+//! a target by row number, parent traversal, keyboard focus, or remote token.
+//! AX notifications are an observed invalidation fence, not an atomic remote
+//! object generation. Unsupported notifications make this path unavailable.
+
+use super::{
+    bindings::*,
+    enablement::process_start_stamp,
+    snapshot::{AxSnapshot, RetainedElement},
+};
+use crate::session::observation::{self, SessionIdentity};
+use core_foundation::{
+    array::{CFArrayGetCount, CFArrayGetTypeID, CFArrayGetValueAtIndex, CFArrayRef},
+    base::{CFEqual, CFGetTypeID, CFRelease, CFRetain, CFTypeRef, TCFType},
+    string::{CFString, CFStringGetLength, CFStringGetTypeID, CFStringRef},
+};
+use serde_json::{json, Value};
+use std::{
+    ffi::c_void,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        mpsc, Arc,
+    },
+    thread,
+    time::{Duration, Instant},
+};
+
+type NativeResult<T> = Result<T, &'static str>;
+type ObserverRef = *mut c_void;
+type RunLoopRef = *mut c_void;
+type RunLoopSourceRef = *mut c_void;
+type ObserverCallback = unsafe extern "C" fn(ObserverRef, AXUIElementRef, CFStringRef, *mut c_void);
+#[link(name = "ApplicationServices", kind = "framework")]
+unsafe extern "C" {
+    fn AXUIElementGetPid(element: AXUIElementRef, pid: *mut i32) -> AXError;
+    fn AXUIElementGetAttributeValueCount(
+        element: AXUIElementRef,
+        attribute: CFStringRef,
+        count: *mut isize,
+    ) -> AXError;
+    fn AXUIElementCopyAttributeValues(
+        element: AXUIElementRef,
+        attribute: CFStringRef,
+        index: isize,
+        max_values: isize,
+        values: *mut CFArrayRef,
+    ) -> AXError;
+    fn AXObserverCreate(
+        pid: i32,
+        callback: ObserverCallback,
+        observer: *mut ObserverRef,
+    ) -> AXError;
+    fn AXObserverAddNotification(
+        observer: ObserverRef,
+        element: AXUIElementRef,
+        notification: CFStringRef,
+        context: *mut c_void,
+    ) -> AXError;
+    fn AXObserverGetRunLoopSource(observer: ObserverRef) -> RunLoopSourceRef;
+}
+#[link(name = "CoreFoundation", kind = "framework")]
+unsafe extern "C" {
+    static kCFRunLoopDefaultMode: CFStringRef;
+    fn CFRunLoopGetCurrent() -> RunLoopRef;
+    fn CFRunLoopAddSource(run_loop: RunLoopRef, source: RunLoopSourceRef, mode: CFStringRef);
+    fn CFRunLoopRemoveSource(run_loop: RunLoopRef, source: RunLoopSourceRef, mode: CFStringRef);
+    fn CFRunLoopRunInMode(mode: CFStringRef, seconds: f64, return_after_source_handled: u8) -> i32;
+}
+
+/// Own any returned +1 CF value, including on an AX error path.
+struct OwnedCf(CFTypeRef);
+impl Drop for OwnedCf {
+    fn drop(&mut self) {
+        if !self.0.is_null() {
+            unsafe { CFRelease(self.0) };
+        }
+    }
+}
+fn raw(element: &RetainedElement) -> AXUIElementRef {
+    element.as_ptr() as AXUIElementRef
+}
+pub(crate) fn same_object(a: &RetainedElement, b: &RetainedElement) -> bool {
+    unsafe { CFEqual(raw(a).cast(), raw(b).cast()) != 0 }
+}
+fn check_time(deadline: Instant) -> NativeResult<()> {
+    if Instant::now() >= deadline {
+        Err("validation_timeout")
+    } else {
+        Ok(())
+    }
+}
+fn timeout(element: &RetainedElement, deadline: Instant) -> NativeResult<()> {
+    check_time(deadline)?;
+    let remaining = deadline
+        .saturating_duration_since(Instant::now())
+        .as_secs_f32();
+    if unsafe { AXUIElementSetMessagingTimeout(raw(element), remaining) } != kAXErrorSuccess {
+        return Err("object_unavailable");
+    }
+    Ok(())
+}
+fn pid_matches(element: &RetainedElement, pid: i32) -> NativeResult<()> {
+    let mut actual = 0;
+    if unsafe { AXUIElementGetPid(raw(element), &mut actual) } != kAXErrorSuccess || actual != pid {
+        Err("unproven_object_owner")
+    } else {
+        Ok(())
+    }
+}
+fn read_attr(element: &RetainedElement, name: &str) -> NativeResult<Option<OwnedCf>> {
+    let name = CFString::new(name);
+    let mut value = std::ptr::null();
+    let code = unsafe {
+        AXUIElementCopyAttributeValue(raw(element), name.as_concrete_TypeRef(), &mut value)
+    };
+    let owned = OwnedCf(value);
+    match code {
+        kAXErrorSuccess if !value.is_null() => Ok(Some(owned)),
+        kAXErrorAttributeUnsupported | kAXErrorNoValue => Ok(None),
+        _ => Err("object_unavailable"),
+    }
+}
+fn string_attr(element: &RetainedElement, name: &str) -> NativeResult<Option<String>> {
+    let Some(value) = read_attr(element, name)? else {
+        return Ok(None);
+    };
+    if unsafe { CFGetTypeID(value.0) } != unsafe { CFStringGetTypeID() } {
+        return Ok(None);
+    }
+    if unsafe { CFStringGetLength(value.0.cast()) } > 4096 {
+        return Err("stale_observation");
+    }
+    let text = unsafe { CFString::wrap_under_get_rule(value.0.cast()) }.to_string();
+    Ok(Some(text))
+}
+fn array_members(value: &OwnedCf, limit: usize) -> NativeResult<Vec<RetainedElement>> {
+    if unsafe { CFGetTypeID(value.0) } != unsafe { CFArrayGetTypeID() } {
+        return Err("object_unavailable");
+    }
+    let array = value.0 as CFArrayRef;
+    let count = unsafe { CFArrayGetCount(array) };
+    if count < 0 || count as usize > limit {
+        return Err("stale_observation");
+    }
+    let mut result = Vec::with_capacity(count as usize);
+    for index in 0..count {
+        let item = unsafe { CFArrayGetValueAtIndex(array, index) };
+        if item.is_null() || unsafe { CFGetTypeID(item) } != unsafe { AXUIElementGetTypeID() } {
+            return Err("object_unavailable");
+        }
+        result.push(unsafe { RetainedElement::retain(item as usize) });
+    }
+    Ok(result)
+}
+/// An unsupported AXChildren is a leaf only when the object's own successfully
+/// copied attribute-name list confirms that the attribute is absent.
+fn confirms_leaf(element: &RetainedElement) -> NativeResult<bool> {
+    let mut array = std::ptr::null();
+    let code = unsafe { AXUIElementCopyAttributeNames(raw(element), &mut array) };
+    let owned = OwnedCf(array.cast());
+    if code != kAXErrorSuccess
+        || owned.0.is_null()
+        || unsafe { CFGetTypeID(owned.0) } != unsafe { CFArrayGetTypeID() }
+    {
+        return Err("object_unavailable");
+    }
+    let count = unsafe { CFArrayGetCount(array) };
+    if !(0..=256).contains(&count) {
+        return Err("object_unavailable");
+    }
+    let children = CFString::new("AXChildren");
+    for index in 0..count {
+        let item = unsafe { CFArrayGetValueAtIndex(array, index) };
+        if item.is_null() || unsafe { CFGetTypeID(item) } != unsafe { CFStringGetTypeID() } {
+            return Err("object_unavailable");
+        }
+        if unsafe { CFEqual(item, children.as_CFTypeRef()) } != 0 {
+            return Ok(false);
+        }
+    }
+    Ok(true)
+}
+fn children(element: &RetainedElement, limit: usize) -> NativeResult<Vec<RetainedElement>> {
+    let name = CFString::new("AXChildren");
+    let mut count = 0;
+    let code = unsafe {
+        AXUIElementGetAttributeValueCount(raw(element), name.as_concrete_TypeRef(), &mut count)
+    };
+    if code == kAXErrorAttributeUnsupported && confirms_leaf(element)? {
+        return Ok(Vec::new());
+    }
+    if code != kAXErrorSuccess || count < 0 {
+        return Err("object_unavailable");
+    }
+    if count as usize > limit {
+        return Err("stale_observation");
+    }
+    if count == 0 {
+        return Ok(Vec::new());
+    }
+    let mut array = std::ptr::null();
+    let code = unsafe {
+        AXUIElementCopyAttributeValues(
+            raw(element),
+            name.as_concrete_TypeRef(),
+            0,
+            count,
+            &mut array,
+        )
+    };
+    let owned = OwnedCf(array.cast());
+    if code != kAXErrorSuccess || owned.0.is_null() {
+        return Err("object_unavailable");
+    }
+    let result = array_members(&owned, limit)?;
+    let mut after = 0;
+    if result.len() != count as usize
+        || unsafe {
+            AXUIElementGetAttributeValueCount(raw(element), name.as_concrete_TypeRef(), &mut after)
+        } != kAXErrorSuccess
+        || after != count
+    {
+        return Err("stale_observation");
+    }
+    Ok(result)
+}
+
+struct FenceState {
+    invalid: AtomicBool,
+    stop: AtomicBool,
+}
+struct Watch {
+    element: RetainedElement,
+    names: Vec<&'static str>,
+    result: mpsc::SyncSender<NativeResult<()>>,
+}
+pub(crate) struct Fence {
+    state: Arc<FenceState>,
+    commands: mpsc::Sender<Watch>,
+    thread: Option<thread::JoinHandle<()>>,
+}
+unsafe extern "C" fn changed(
+    _: ObserverRef,
+    _: AXUIElementRef,
+    _: CFStringRef,
+    context: *mut c_void,
+) {
+    // Context is the thread-owned Arc allocation, kept alive until source removal
+    // and observer release. The callback never accesses the target or Rust locks.
+    if !context.is_null() {
+        unsafe { &*(context as *const FenceState) }
+            .invalid
+            .store(true, Ordering::Release);
+    }
+}
+impl Fence {
+    fn start(pid: i32, deadline: Instant) -> NativeResult<Self> {
+        let state = Arc::new(FenceState {
+            invalid: AtomicBool::new(false),
+            stop: AtomicBool::new(false),
+        });
+        let thread_state = state.clone();
+        let (commands, incoming) = mpsc::channel::<Watch>();
+        let (ready_tx, ready_rx) = mpsc::sync_channel(1);
+        let thread = thread::Builder::new()
+            .name("styx-ax-fence".into())
+            .spawn(move || {
+                let mut observer = std::ptr::null_mut();
+                if unsafe { AXObserverCreate(pid, changed, &mut observer) } != kAXErrorSuccess
+                    || observer.is_null()
+                {
+                    thread_state.invalid.store(true, Ordering::Release);
+                    if !observer.is_null() {
+                        unsafe { CFRelease(observer.cast()) };
+                    }
+                    let _ = ready_tx.send(Err("target_invalidated"));
+                    return;
+                }
+                let observer_owner = OwnedCf(observer.cast());
+                let source = unsafe { AXObserverGetRunLoopSource(observer) };
+                if source.is_null() {
+                    let _ = ready_tx.send(Err("target_invalidated"));
+                    return;
+                }
+                let run_loop = unsafe { CFRunLoopGetCurrent() };
+                unsafe { CFRunLoopAddSource(run_loop, source, kCFRunLoopDefaultMode) };
+                let _ = ready_tx.send(Ok(()));
+                while !thread_state.stop.load(Ordering::Acquire) {
