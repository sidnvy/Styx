+                            let element = state.elements.get(row).ok_or("stale_observation")?;
+                            if element.as_raw() as usize != pointer {
+                                return Err("target_identity_changed");
+                            }
+                            state.editable(row, deadline)?;
+                            state.sequence = state
+                                .sequence
