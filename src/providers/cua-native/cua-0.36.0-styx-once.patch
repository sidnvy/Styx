+//! Private native-work lifetime accounting, scoped to one SdkAdapter/runtime.
+//! No grants, public operation IDs or caller-selected cleanup authority.
+use std::collections::{BTreeSet, HashMap};
+use std::sync::{Arc, Mutex};
+use tokio::sync::Notify;
+
+const MAX_TRANSPORTS: usize = 256;
+const MAX_CALLS: usize = 64;
+const MAX_SESSIONS: usize = 256;
+#[derive(Default)]
+pub(super) struct Transports(Mutex<HashMap<String, Arc<Transport>>>);
+#[derive(Default)]
+struct State {
+    control_claimed: bool,
+    closing: bool,
+    in_flight: usize,
+    interrupted: bool,
+    sessions: BTreeSet<String>,
+}
+#[derive(Default)]
+pub(super) struct Transport {
+    state: Mutex<State>,
+    changed: Notify,
+    cleanup: tokio::sync::Mutex<Cleanup>,
+}
+#[derive(Default)]
+enum Cleanup {
+    #[default]
+    NotStarted,
+    Running(tokio::task::JoinHandle<Result<(), String>>),
+    Finished(Result<(), String>),
+}
+pub(super) struct Call {
+    transport: Arc<Transport>,
+    settled: bool,
+}
+impl Transports {
+    fn get(&self, id: &str) -> Result<Arc<Transport>, &'static str> {
+        if id.is_empty() || id.len() > 256 {
+            return Err("transport_identity_invalid");
+        }
+        let mut all = self.0.lock().unwrap();
+        if let Some(value) = all.get(id) {
+            return Ok(value.clone());
+        }
+        if all.len() == MAX_TRANSPORTS {
+            return Err("transport_capacity");
+        }
+        let value = Arc::new(Transport::default());
+        all.insert(id.to_owned(), value.clone());
+        Ok(value)
+    }
+    pub(super) fn claim_control(&self, id: &str) -> Result<(), &'static str> {
+        let value = self.get(id)?;
+        let mut state = value.state.lock().unwrap();
+        if state.closing || state.control_claimed {
+            return Err("transport_control_already_bound");
+        }
+        state.control_claimed = true;
+        Ok(())
+    }
+    pub(super) fn enter(&self, id: &str, session: Option<String>) -> Result<Call, &'static str> {
+        let value = self.get(id)?;
+        {
+            let mut state = value.state.lock().unwrap();
+            if state.closing {
+                return Err("transport_closed");
+            }
+            if state.in_flight == MAX_CALLS {
+                return Err("transport_inflight_capacity");
+            }
+            if let Some(session) = session {
+                if session.len() > 1024
+                    || (!state.sessions.contains(&session) && state.sessions.len() == MAX_SESSIONS)
+                {
+                    return Err("transport_session_capacity");
+                }
+                state.sessions.insert(session);
+            }
+            state.in_flight += 1;
+        }
+        Ok(Call {
+            transport: value,
+            settled: false,
+        })
+    }
+    pub(super) fn close(&self, id: &str) -> Result<Arc<Transport>, &'static str> {
+        let all = self.0.lock().unwrap();
+        let value = all.get(id).ok_or("transport_not_registered")?.clone();
+        value.state.lock().unwrap().closing = true;
+        Ok(value)
+    }
+}
+impl Call {
+    pub(super) fn settled(&mut self) {
+        self.settled = true;
+    }
+}
+impl Drop for Call {
+    fn drop(&mut self) {
+        let mut state = self.transport.state.lock().unwrap();
+        state.in_flight -= 1;
+        state.interrupted |= !self.settled;
+        drop(state);
+        self.transport.changed.notify_waiters();
+    }
+}
+impl Transport {
+    pub(super) async fn finish_cleanup<F>(&self, work: F) -> Result<(), String>
+    where
+        F: FnOnce() -> Result<(), String> + Send + 'static,
+    {
+        let mut cleanup = self.cleanup.lock().await;
+        // Completed failed hooks may be queried/retried by the SAME bound
+        // control. The platform hook retains its original removal receipt.
+        if matches!(&*cleanup, Cleanup::NotStarted | Cleanup::Finished(Err(_))) {
+            *cleanup = Cleanup::Running(tokio::task::spawn_blocking(work));
+        }
+        let result = match &mut *cleanup {
+            Cleanup::Running(task) => task
+                .await
+                .unwrap_or_else(|_| Err("transport_cleanup_task_unknown".into())),
+            Cleanup::Finished(result) => return result.clone(),
+            Cleanup::NotStarted => unreachable!(),
+        };
+        // Await by borrowing the STORED original handle. Dropping a control
+        // waiter before completion leaves Running intact, never detached/replaced.
+        *cleanup = Cleanup::Finished(result.clone());
+        result
+    }
+
+    pub(super) async fn wait(&self) -> Result<Vec<String>, &'static str> {
+        loop {
+            // Enable notification before testing the predicate: no lost final drop.
+            let change = self.changed.notified();
