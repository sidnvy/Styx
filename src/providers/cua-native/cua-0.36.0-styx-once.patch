+        request = drain => request.is_ok(),
+        _ = reader.read_line(&mut line) => false,
+    };
+    let result = async {
+        if !requested {
+            return Err("private_transport_drain_unknown".to_owned());
+        }
+        // No sid, arguments, tool name or caller-selected field is sent.
+        reader
+            .get_mut()
+            .write_all(b"{\"method\":\"styx_private_transport_drain_v1\"}\n")
+            .await
+            .map_err(|_| "private_transport_drain_unknown".to_owned())?;
+        reader
+            .get_mut()
+            .flush()
+            .await
+            .map_err(|_| "private_transport_drain_unknown".to_owned())?;
+        line.clear();
+        let n = reader
+            .read_line(&mut line)
+            .await
+            .map_err(|_| "private_transport_drain_unknown".to_owned())?;
+        if n == 0 || n > 4096 {
+            return Err("private_transport_drain_unknown".to_owned());
+        }
+        let response: DaemonResponse = serde_json::from_str(&line)
+            .map_err(|_| "private_transport_drain_unknown".to_owned())?;
+        if !response.ok || response.result != Some(serde_json::json!({"schema":1,"drained":true})) {
+            return Err("private_transport_drain_unknown".to_owned());
+        }
+        Ok(())
+    }
+    .await;
+    let _ = drained.send(result);
 }
 
