+pub(crate) fn acquire(
+    snapshot: Arc<CompleteSnapshot>,
+    row: usize,
+    element: RetainedElement,
+) -> NativeResult<EditableTarget> {
+    if !snapshot.valid()
+        || !element.is_uia()
+        || snapshot
+            .elements
+            .get(row)
+            .is_none_or(|original| original.as_ptr() != element.as_ptr())
+    {
+        return Err("stale_observation");
+    }
+    let (reply, receive) = mpsc::sync_channel(1);
+    snapshot
+        .worker
+        .commands
+        .try_send(Command::Acquire {
+            row,
+            pointer: element.as_ptr(),
+            reply,
+        })
+        .map_err(|_| "target_cache_unavailable")?;
