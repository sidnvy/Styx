+#[cfg(test)]
+mod styx_observed_epoch_tests {
+    use super::StyxEventFence;
+    use std::sync::atomic::AtomicU64;
+
+    #[test]
+    fn local_observation_epoch_rejects_changed_snapshots() {
+        let fence = StyxEventFence::new();
+        assert_eq!(fence.capture(), None);
+        fence.activate();
+        let observed = fence.capture().expect("local listener ready");
+        assert!(fence.matches(observed));
+        fence.advance(); // Same operation used for structural/defunct events.
+        assert!(!fence.matches(observed));
+        let next = fence.capture().expect("healthy later observation");
+        assert!(next > observed);
+        assert!(fence.matches(next));
+    }
+
+    #[test]
+    fn local_stream_or_subscription_loss_cannot_reactivate() {
+        for activated in [false, true] {
+            let fence = StyxEventFence::new();
+            if activated { fence.activate(); }
+            fence.lost(); // Subscription failure, stream Err or EOF path.
+            fence.activate(); // A late initialization must never revive it.
+            fence.advance();
+            assert_eq!(fence.capture(), None);
+            assert!(!fence.matches(1));
+        }
+    }
+
+    #[test]
+    fn local_epoch_overflow_is_terminal_without_aba() {
+        let fence = StyxEventFence { state: AtomicU64::new(u64::MAX - 1) };
+        assert!(fence.matches(u64::MAX - 1));
+        fence.advance();
+        assert_eq!(fence.capture(), None);
+        fence.activate();
+        fence.advance();
+        assert_eq!(fence.capture(), None);
+        assert!(!fence.matches(1));
+    }
+}
