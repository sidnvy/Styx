+                Some(pending)
+                    if pending.nonce == nonce
+                        && pending.transport == transport
+                        && pending.session == session =>
+                {
+                    pending
+                }
+                _ => return refusal("stale_observation"),
+            }
+        };
+        match self.state.snapshots.resolve(
+            pending.pid,
+            &json!({"window_id":pending.window,"element_token":pending.native_token}),
+        ) {
+            Ok(ResolvedElement::Element {
+                window_id, element, ..
+            }) if window_id == u64::from(pending.window) && pending.target.matches(&element) => {}
