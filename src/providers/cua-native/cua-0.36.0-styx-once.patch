+struct StyxSetTextOnceTool { state: Arc<ToolState> }
+static STYX_SET_TEXT_ONCE_DEF: std::sync::OnceLock<ToolDef> = std::sync::OnceLock::new();
+#[async_trait]
+impl Tool for StyxSetTextOnceTool {
+    fn def(&self) -> &ToolDef {
