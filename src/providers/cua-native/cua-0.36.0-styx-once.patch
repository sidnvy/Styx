+            (table.GetFirstChildElement)(walker.as_raw(), node.as_raw(), &mut raw)
+        } else {
+            (table.GetNextSiblingElement)(walker.as_raw(), node.as_raw(), &mut raw)
+        }
+    };
+    if result != windows::core::HRESULT(0) {
+        if !raw.is_null() {
+            drop(unsafe { IUIAutomationElement::from_raw(raw) });
+        }
+        return Err("object_unavailable");
+    }
+    Ok((!raw.is_null()).then(|| unsafe { IUIAutomationElement::from_raw(raw) }))
