+//! Narrow, fail-closed observation for Styx's private AX once-write path.
+//!
+//! IOConsoleUsers is an Apple private registry schema (IOKitKeysPrivate.h).
+//! Missing lock state is Unknown, never unlocked. A read is not an atomic OS
+//! action fence and cannot detect an entire lock/unlock episode between reads.
+//! This does not change Cua's general graphic-session capability probe.
+
+use super::{SessionGetInfo, CALLER_SECURITY_SESSION, SESSION_HAS_GRAPHIC_ACCESS};
+use core_foundation::{
+    array::{CFArrayGetCount, CFArrayGetTypeID, CFArrayGetValueAtIndex},
+    base::{CFAllocatorRef, CFGetTypeID, CFRelease, CFTypeRef, TCFType},
+    boolean::{kCFBooleanFalse, kCFBooleanTrue, CFBooleanGetTypeID},
+    dictionary::{CFDictionaryGetTypeID, CFDictionaryGetValue, CFDictionaryRef},
+    number::{kCFNumberSInt64Type, CFNumberGetTypeID, CFNumberGetValue, CFNumberIsFloatType},
+    string::{CFString, CFStringRef},
+};
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) struct SessionIdentity {
+    pub(crate) uid: u32,
+    pub(crate) audit_id: u32,
+}
+
+/// These are local platform facts, not a replacement for Core authorization.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum SessionUnavailable {
+    Unknown,
+    Locked,
+    NoGraphicalSession,
+    Disconnected,
+    Ambiguous,
+    IdentityChanged,
+}
+impl SessionUnavailable {
+    pub(crate) fn code(self) -> &'static str {
+        match self {
+            Self::Unknown => "desktop_session_unknown",
+            Self::Locked => "desktop_session_locked",
+            Self::NoGraphicalSession => "no_graphical_session",
+            Self::Disconnected => "desktop_session_disconnected",
+            Self::Ambiguous => "desktop_session_ambiguous",
+            Self::IdentityChanged => "desktop_session_changed",
+        }
+    }
+}
+type Observed<T> = Result<T, SessionUnavailable>;
+
+// No IOKit crate exists in this pinned platform. These three public APIs only
+// read the fixed registry root; no user client, arbitrary path, or write API.
+#[link(name = "IOKit", kind = "framework")]
+unsafe extern "C" {
+    fn IORegistryGetRootEntry(main_port: u32) -> u32;
+    fn IORegistryEntryCreateCFProperty(
+        entry: u32,
+        key: CFStringRef,
+        allocator: CFAllocatorRef,
+        options: u32,
+    ) -> CFTypeRef;
+    fn IOObjectRelease(object: u32) -> i32;
+}
+struct RegistryEntry(u32);
+impl Drop for RegistryEntry {
+    fn drop(&mut self) {
+        unsafe { IOObjectRelease(self.0) };
+    }
+}
+struct OwnedCf(CFTypeRef);
+impl Drop for OwnedCf {
+    fn drop(&mut self) {
+        if !self.0.is_null() {
+            unsafe { CFRelease(self.0) };
+        }
+    }
+}
+
+fn caller_identity() -> Observed<SessionIdentity> {
+    let uid = unsafe { libc::getuid() };
+    if uid != unsafe { libc::geteuid() } {
+        return Err(SessionUnavailable::Unknown);
+    }
+    let mut session = 0;
+    let mut attributes = 0;
+    if unsafe { SessionGetInfo(CALLER_SECURITY_SESSION, &mut session, &mut attributes) } != 0 {
+        return Err(SessionUnavailable::Unknown);
+    }
+    if attributes & SESSION_HAS_GRAPHIC_ACCESS == 0 {
+        return Err(SessionUnavailable::NoGraphicalSession);
+    }
+    // SecuritySessionId is UInt32 in the API; the existing ABI declaration uses
+    // i32. Preserve its bits but refuse special/reserved, non-identity values.
+    let audit_id = session as u32;
+    if matches!(audit_id, 0 | u32::MAX) || audit_id == u32::MAX - 1 {
+        return Err(SessionUnavailable::Unknown);
+    }
+    Ok(SessionIdentity { uid, audit_id })
+}
+
+fn field(dictionary: CFDictionaryRef, name: &str) -> CFTypeRef {
+    let name = CFString::new(name);
+    // dictionary is checked before this helper, and its owner remains alive.
+    unsafe { CFDictionaryGetValue(dictionary, name.as_CFTypeRef()) }
+}
+fn integer(value: CFTypeRef) -> Observed<u32> {
+    if value.is_null()
+        || unsafe { CFGetTypeID(value) } != unsafe { CFNumberGetTypeID() }
+        || unsafe { CFNumberIsFloatType(value.cast()) } != 0
+    {
+        return Err(SessionUnavailable::Unknown);
+    }
+    let mut number: i64 = 0;
+    if !unsafe {
+        CFNumberGetValue(
+            value.cast(),
+            kCFNumberSInt64Type,
+            (&mut number as *mut i64).cast(),
+        )
+    } {
+        return Err(SessionUnavailable::Unknown);
+    }
+    u32::try_from(number).map_err(|_| SessionUnavailable::Unknown)
+}
+fn boolean(value: CFTypeRef) -> Observed<bool> {
+    if value.is_null() || unsafe { CFGetTypeID(value) } != unsafe { CFBooleanGetTypeID() } {
+        return Err(SessionUnavailable::Unknown);
+    }
+    if value == unsafe { kCFBooleanTrue }.cast() {
+        Ok(true)
+    } else if value == unsafe { kCFBooleanFalse }.cast() {
+        Ok(false)
+    } else {
+        Err(SessionUnavailable::Unknown)
+    }
+}
+
+/// Parse only retained CF objects returned by the native registry, never JSON
+/// from a client. Non-matching sessions need valid identity fields so malformed
+/// data cannot hide a second match. Their lock/presence states do not authorize us.
+fn selected_session(users: &OwnedCf, expected: SessionIdentity) -> Observed<()> {
+    if users.0.is_null() || unsafe { CFGetTypeID(users.0) } != unsafe { CFArrayGetTypeID() } {
+        return Err(SessionUnavailable::Unknown);
+    }
+    let array = users.0.cast();
+    let count = unsafe { CFArrayGetCount(array) };
+    // A conservative parse-work limit, not a platform session-count claim.
+    if !(0..=4096).contains(&count) {
+        return Err(SessionUnavailable::Unknown);
+    }
+    let mut selected = None;
+    for index in 0..count {
+        let item = unsafe { CFArrayGetValueAtIndex(array, index) };
+        if item.is_null() || unsafe { CFGetTypeID(item) } != unsafe { CFDictionaryGetTypeID() } {
+            return Err(SessionUnavailable::Unknown);
+        }
+        let dictionary = item.cast();
+        let uid = integer(field(dictionary, "kCGSSessionUserIDKey"))?;
+        let audit_id = integer(field(dictionary, "kCGSSessionAuditIDKey"))?;
+        // Conflicting ownership for our audit identity is not another candidate.
+        if audit_id == expected.audit_id && uid != expected.uid {
+            return Err(SessionUnavailable::Ambiguous);
+        }
+        if (SessionIdentity { uid, audit_id }) == expected && selected.replace(dictionary).is_some()
+        {
+            return Err(SessionUnavailable::Ambiguous);
+        }
+    }
+    let dictionary = selected.ok_or(SessionUnavailable::Disconnected)?;
+    let on_console = boolean(field(dictionary, "kCGSSessionOnConsoleKey"))?;
+    let login_done = boolean(field(dictionary, "kCGSessionLoginDoneKey"))?;
+    let locked = boolean(field(dictionary, "CGSSessionScreenIsLocked"))?;
+    if locked {
+        return Err(SessionUnavailable::Locked);
+    }
+    if !on_console || !login_done {
+        return Err(SessionUnavailable::Disconnected);
+    }
+    Ok(())
+}
+
+/// A successful result records a currently observed unlocked caller session.
+/// It is not a lease, generation, or guarantee that the next action is atomic
+/// with this read. Native OS permissions and the existing Core grant still apply.
+pub(crate) fn observe_unlocked_current() -> Observed<SessionIdentity> {
+    let identity = caller_identity()?;
+    let root = unsafe { IORegistryGetRootEntry(0) }; // kIOMainPortDefault
+    if root == 0 {
+        return Err(SessionUnavailable::Unknown);
+    }
+    let root = RegistryEntry(root);
+    let key = CFString::new("IOConsoleUsers");
+    let users = OwnedCf(unsafe {
+        IORegistryEntryCreateCFProperty(root.0, key.as_concrete_TypeRef(), std::ptr::null(), 0)
+    });
+    // The CF API returns null on missing property or access refusal. Both must
+    // remain Unknown: do not claim a specific permission error without evidence.
+    selected_session(&users, identity)?;
+    if caller_identity()? != identity {
+        return Err(SessionUnavailable::IdentityChanged);
+    }
+    Ok(identity)
+}
+
+pub(crate) fn revalidate(expected: SessionIdentity) -> Observed<()> {
+    if observe_unlocked_current()? != expected {
+        Err(SessionUnavailable::IdentityChanged)
+    } else {
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use core_foundation::{
+        array::CFArray,
+        base::{CFRetain, CFType},
+        boolean::CFBoolean,
+        dictionary::CFDictionary,
+        number::CFNumber,
+    };
+
+    fn row(
+        uid: i64,
+        audit: i64,
+        on_console: bool,
+        lock: Option<CFType>,
+    ) -> CFDictionary<CFString, CFType> {
+        let mut fields = vec![
+            (
+                CFString::new("kCGSSessionUserIDKey"),
+                CFNumber::from(uid).as_CFType(),
+            ),
+            (
+                CFString::new("kCGSSessionAuditIDKey"),
+                CFNumber::from(audit).as_CFType(),
+            ),
+            (
+                CFString::new("kCGSSessionOnConsoleKey"),
+                CFBoolean::from(on_console).as_CFType(),
+            ),
+            (
+                CFString::new("kCGSessionLoginDoneKey"),
+                CFBoolean::from(true).as_CFType(),
+            ),
+        ];
+        if let Some(lock) = lock {
+            fields.push((CFString::new("CGSSessionScreenIsLocked"), lock));
+        }
+        CFDictionary::from_CFType_pairs(&fields)
+    }
+
+    fn parse(rows: &[CFDictionary<CFString, CFType>]) -> Observed<()> {
+        let users = CFArray::from_CFTypes(rows);
+        let owned = OwnedCf(unsafe { CFRetain(users.as_CFTypeRef()) });
+        selected_session(
+            &owned,
+            SessionIdentity {
+                uid: 501,
+                audit_id: 1001,
+            },
+        )
+    }
+
+    // Pure CF parser contract: no session read, desktop, TCC, or host state.
+    // This does not establish that a real unlocked OS emits an explicit false.
+    #[test]
+    fn only_the_unique_explicitly_unlocked_caller_session_is_admitted() {
+        let unlocked = row(501, 1001, true, Some(CFBoolean::from(false).as_CFType()));
+        let other = row(502, 1002, true, Some(CFBoolean::from(false).as_CFType()));
+        assert_eq!(parse(&[other.clone(), unlocked.clone()]), Ok(()));
+        assert_eq!(parse(&[other]), Err(SessionUnavailable::Disconnected));
+        assert_eq!(
+            parse(&[unlocked.clone(), unlocked]),
+            Err(SessionUnavailable::Ambiguous)
+        );
+        assert_eq!(
+            parse(&[row(
+                502,
+                1001,
+                true,
+                Some(CFBoolean::from(false).as_CFType())
+            )]),
+            Err(SessionUnavailable::Ambiguous)
+        );
+        assert_eq!(
+            parse(&[row(
+                501,
+                1001,
+                true,
+                Some(CFBoolean::from(true).as_CFType())
+            )]),
+            Err(SessionUnavailable::Locked)
+        );
+        assert_eq!(
+            parse(&[row(
+                501,
+                1001,
+                false,
+                Some(CFBoolean::from(false).as_CFType())
+            )]),
+            Err(SessionUnavailable::Disconnected)
+        );
+        assert_eq!(
+            parse(&[row(501, 1001, true, None)]),
+            Err(SessionUnavailable::Unknown)
+        );
+        assert_eq!(
+            parse(&[row(501, 1001, true, Some(CFNumber::from(0).as_CFType()))]),
+            Err(SessionUnavailable::Unknown)
+        );
+        assert_eq!(
+            parse(&[row(
+                -1,
+                1001,
+                true,
+                Some(CFBoolean::from(false).as_CFType())
+            )]),
+            Err(SessionUnavailable::Unknown)
+        );
+        assert_eq!(parse(&[]), Err(SessionUnavailable::Disconnected));
+    }
+}
