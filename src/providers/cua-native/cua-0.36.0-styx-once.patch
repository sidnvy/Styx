+                                            if state.invalid.swap(true, Ordering::AcqRel) {
+                                                WriteOutcome::NotDispatched("target_invalidated")
+                                            } else {
+                                                match unsafe {
+                                                    pattern.SetValue(&BSTR::from(value.as_str()))
+                                                } {
+                                                    Ok(()) => WriteOutcome::Acknowledged,
+                                                    Err(_) => WriteOutcome::Unknown,
+                                                }
+                                            }
+                                        }
+                                        Err(e) => WriteOutcome::NotDispatched(e),
+                                    },
+                                    Err(e) => WriteOutcome::NotDispatched(e),
+                                }
+                            }
+                            _ => WriteOutcome::NotDispatched("stale_observation"),
+                        };
+                        let _ = reply.send(answer);
+                    }
+                }
+            }
+        })
+        .map_err(|_| "target_cache_unavailable")?;
+    let worker = Worker {
+        invalid,
+        stop,
+        commands,
+        thread: Some(thread),
+    };
+    let (rows, elements, birth) = result
+        .recv_timeout(deadline.saturating_duration_since(Instant::now()))
+        .map_err(|_| "validation_timeout")??;
+    Ok(CompleteSnapshot {
+        pid,
+        window_id,
+        birth,
+        rows,
+        elements,
+        worker,
+    })
+}
+pub(crate) struct EditableTarget {
+    snapshot: Arc<CompleteSnapshot>,
+    element: RetainedElement,
+    sequence: u64,
