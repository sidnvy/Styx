+//! Private complete UIA observation and single-consume Edit ValuePattern write.
+//! The original non-UI MTA owns all UIA calls and event subscriptions. Events
+//! invalidate; they never select a new window or confer authorization.
+use super::snapshot::{RetainedElement, UiaSnapshot};
+use serde_json::{json, Value};
+use std::{
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        mpsc, Arc,
+    },
+    thread,
+    time::{Duration, Instant},
+};
+use windows::{
+    core::{implement, Interface, BSTR, VARIANT},
+    Win32::{
+        Foundation::HWND,
+        System::Com::{
+            CoCreateInstance, CoInitializeEx, CoUninitialize, CLSCTX_INPROC_SERVER,
+            COINIT_MULTITHREADED, SAFEARRAY,
+        },
+        UI::Accessibility::*,
+    },
+};
+#[path = "styx_private/binding.rs"]
+mod binding;
+use binding::WindowBinding;
+type NativeResult<T> = Result<T, &'static str>;
+
+#[implement(
+    IUIAutomationPropertyChangedEventHandler,
+    IUIAutomationStructureChangedEventHandler
+)]
+struct Invalidator {
+    invalid: Arc<AtomicBool>,
+}
+impl IUIAutomationPropertyChangedEventHandler_Impl for Invalidator_Impl {
+    fn HandlePropertyChangedEvent(
+        &self,
+        _: Option<&IUIAutomationElement>,
+        _: UIA_PROPERTY_ID,
+        _: &VARIANT,
+    ) -> windows::core::Result<()> {
+        self.invalid.store(true, Ordering::Release);
+        Ok(())
+    }
+}
+impl IUIAutomationStructureChangedEventHandler_Impl for Invalidator_Impl {
+    fn HandleStructureChangedEvent(
+        &self,
+        _: Option<&IUIAutomationElement>,
+        _: StructureChangeType,
+        _: *const SAFEARRAY,
+    ) -> windows::core::Result<()> {
+        self.invalid.store(true, Ordering::Release);
+        Ok(())
+    }
+}
+struct Apartment;
+impl Drop for Apartment {
+    fn drop(&mut self) {
+        unsafe { CoUninitialize() };
+    }
+}
+struct State {
+    automation: IUIAutomation,
+    timeouts: IUIAutomation2,
+    root: IUIAutomationElement,
+    walker: IUIAutomationTreeWalker,
+    properties: IUIAutomationPropertyChangedEventHandler,
+    structure: IUIAutomationStructureChangedEventHandler,
+    properties_added: bool,
+    structure_added: bool,
+    binding: WindowBinding,
+    invalid: Arc<AtomicBool>,
+    elements: Vec<IUIAutomationElement>,
+    values: Vec<Option<String>>,
+    pending: Option<(u64, usize)>,
+    sequence: u64,
+    captured: Instant,
+}
+impl Drop for State {
+    fn drop(&mut self) {
+        self.invalid.store(true, Ordering::Release);
+        // The exact subscription owner removes on the same original MTA. A
+        // failed COM removal is not cleanup success; direct worker Job teardown
+        // is the final physical lifetime boundary, never this Rust Drop alone.
+        unsafe {
+            if self.properties_added {
+                let _ = self
+                    .automation
+                    .RemovePropertyChangedEventHandler(&self.root, &self.properties);
+            }
+            if self.structure_added {
+                let _ = self
+                    .automation
+                    .RemoveStructureChangedEventHandler(&self.root, &self.structure);
+            }
+        }
+    }
+}
+fn budget(automation: &IUIAutomation2, deadline: Instant) -> NativeResult<()> {
+    let ms = deadline
+        .saturating_duration_since(Instant::now())
+        .as_millis();
+    if ms == 0 {
+        return Err("validation_timeout");
+    }
+    let ms = u32::try_from(ms).map_err(|_| "validation_timeout")?;
+    unsafe {
+        automation
+            .SetConnectionTimeout(ms)
+            .map_err(|_| "object_unavailable")?;
+        automation
+            .SetTransactionTimeout(ms)
+            .map_err(|_| "object_unavailable")?;
+    }
+    Ok(())
+}
+fn text(value: BSTR) -> NativeResult<String> {
+    if value.len() > 4096 {
+        return Err("stale_observation");
+    }
+    String::from_utf16(value.as_wide()).map_err(|_| "object_unavailable")
