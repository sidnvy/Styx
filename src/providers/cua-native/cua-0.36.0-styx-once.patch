+            name:"styx_private_ax_set_text_once_v1".into(),
+            description:"Private single-consume exact EditableText write; ACK does not verify application effect.".into(),
+            input_schema:json!({"type":"object","required":["editable_target","value"],"properties":{
+                "editable_target":{"type":"string","minLength":64,"maxLength":64},
+                "value":{"type":"string","maxLength":16384}},"additionalProperties":false}),
+            read_only:false,destructive:true,idempotent:false,open_world:false,
+        })
+    }
