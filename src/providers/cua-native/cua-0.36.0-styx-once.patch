+// Private Styx adapter tools in this separately versioned artifact. They do not
+// replace or rename any of the standard 64 tools. Native target tokens are only
+// useful on the original owned child transport; Core remains the action ledger.
+#[derive(Default)]
+struct StyxOnceSlot {
+    revision: u64,
+    pending: Option<StyxPendingEditable>,
+}
+struct StyxPendingEditable {
+    nonce: String,
+    transport: String,
+    session: String,
+    pid: u32,
+    window: u64,
+    native_token: String,
+    identity: crate::atspi::AtspiIdentity,
+    event_epoch: u64,
+    target: crate::atspi::native::StyxEditableTarget,
+}
+fn styx_private_result(code: &'static str, certainty: &'static str) -> ToolResult {
+    ToolResult::error(code).with_structured(json!({
+        "schema":1,"code":code,"execution_certainty":certainty,
+        "uncertain":certainty == "unknown"
+    }))
+}
+fn styx_private_lifecycle(args: &Value) -> Result<(String, String, cua_driver_core::session::SessionDispatchGuard), ToolResult> {
+    let transport = args.get("_transport_session_id").and_then(Value::as_str)
+        .ok_or_else(|| styx_private_result("transport_required", "not_dispatched"))?;
+    let session = args.get("_session_id").and_then(Value::as_str)
+        .ok_or_else(|| styx_private_result("transport_required", "not_dispatched"))?;
+    let snapshot = cua_driver_core::session::session_snapshot(session, transport, std::time::Duration::ZERO)
+        .ok_or_else(|| styx_private_result("lifecycle_unavailable", "not_dispatched"))?;
+    let guard = cua_driver_core::session::begin_session_dispatch(
+        session, snapshot.public_label.as_deref(), transport, snapshot.implicit,
+        snapshot.transport, snapshot.client_kind,
+    ).map_err(|_| styx_private_result("lifecycle_unavailable", "not_dispatched"))?;
+    Ok((transport.to_owned(), session.to_owned(), guard))
+}
