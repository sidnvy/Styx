+    if value.contains('\0') {
+        return WriteOutcome::NotDispatched("invalid_request");
+    }
+    if !target.snapshot.valid() {
+        return WriteOutcome::NotDispatched("target_invalidated");
+    }
+    let (reply, receive) = mpsc::sync_channel(1);
+    if target
+        .snapshot
+        .worker
+        .commands
+        .try_send(Command::Write {
+            sequence: target.sequence,
+            value,
+            reply,
+        })
+        .is_err()
+    {
+        target.snapshot.invalidate();
+        return WriteOutcome::NotDispatched("target_cache_unavailable");
+    }
+    // Wait for the original native result, never turn waiter timeout into a
+    // cancelled action. Host owns direct-worker Job cancellation and settlement.
+    receive.recv().unwrap_or(WriteOutcome::Unknown)
