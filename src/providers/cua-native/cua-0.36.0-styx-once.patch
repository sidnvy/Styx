+                let command = match incoming.recv_timeout(Duration::from_millis(10)) {
+                    Ok(c) => c,
+                    Err(mpsc::RecvTimeoutError::Timeout) => continue,
+                    Err(_) => break,
+                };
+                let deadline = Instant::now() + Duration::from_secs(3);
+                match command {
+                    Command::Acquire {
+                        row,
+                        pointer,
+                        reply,
+                    } => {
+                        state.pending.take();
