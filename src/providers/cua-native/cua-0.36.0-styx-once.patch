+            Ok(WriteOutcome::Acknowledged) => ToolResult::text("private_write_acknowledged").with_structured(json!({"schema":1,"target_consumed":true,"outcome":"acknowledged","effect":"unverified"})),
+            Ok(WriteOutcome::NotDispatched(code)) => refusal(code),
+            Ok(WriteOutcome::Unknown) | Err(_) => result("native_write_unknown", "unknown"),
+        }
+    }
+}
