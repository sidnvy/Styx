+//! Internal adapter operations: no new public Styx tool or authorization owner.
+use super::ToolState;
+use crate::ax::styx_private::{self as native, CompleteSnapshot, EditableTarget, WriteOutcome};
+use async_trait::async_trait;
+use cua_driver_core::{
+    element_token::{format_snapshot_id, parse_token, token_for, ResolvedElement},
+    protocol::ToolResult,
+    tool::{Tool, ToolDef, ToolRegistry},
+};
+use serde_json::{json, Value};
+use std::{
+    sync::{Arc, Mutex, OnceLock},
+    time::{Duration, Instant},
+};
+
+struct CachedSnapshot {
+    id: u32,
+    transport: String,
+    session: String,
+    native: Arc<CompleteSnapshot>,
+}
+struct Pending {
+    nonce: String,
+    transport: String,
+    session: String,
+    pid: i32,
+    window: u32,
+    native_token: String,
+    target: EditableTarget,
+}
+#[derive(Default)]
+struct Slot {
+    revision: u64,
+    snapshot: Option<CachedSnapshot>,
+    pending: Option<Pending>,
+}
+#[derive(Default)]
+pub(crate) struct PrivateAx {
+    slot: Mutex<Slot>,
+}
+impl Slot {
+    fn advance(&mut self) -> Result<u64, ToolResult> {
+        self.pending.take();
+        self.revision = self
+            .revision
+            .checked_add(1)
+            .ok_or_else(|| refusal("target_cache_exhausted"))?;
+        Ok(self.revision)
+    }
+    fn retire_snapshot(&mut self) {
+        if let Some(snapshot) = self.snapshot.take() {
+            snapshot.native.invalidate();
+        }
+    }
+}
+impl PrivateAx {
+    pub(crate) fn retire(&self, session: Option<&str>) {
+        // A poisoned cache cannot be reused by any tool. Still release its AX
+        // observer and original references during runtime cleanup.
+        let mut slot = self.slot.lock().unwrap_or_else(|error| error.into_inner());
+        if session.is_none()
+            || slot
+                .snapshot
+                .as_ref()
+                .is_some_and(|snapshot| Some(snapshot.session.as_str()) == session)
+        {
+            let _ = slot.advance();
+            slot.retire_snapshot();
+        }
+    }
+}
+impl Drop for PrivateAx {
+    fn drop(&mut self) {
+        self.retire(None);
+    }
+}
+
+fn result(code: &'static str, certainty: &'static str) -> ToolResult {
+    ToolResult::error(code).with_structured(json!({"schema":1,"code":code,"execution_certainty":certainty,"uncertain":certainty == "unknown"}))
+}
+fn refusal(code: &'static str) -> ToolResult {
+    result(code, "not_dispatched")
+}
+fn lifecycle(
+    args: &Value,
+) -> Result<
+    (
+        String,
+        String,
+        cua_driver_core::session::SessionDispatchGuard,
+    ),
+    ToolResult,
+> {
+    let transport = args
+        .get("_transport_session_id")
+        .and_then(Value::as_str)
+        .ok_or_else(|| refusal("transport_required"))?;
+    let session = args
+        .get("_session_id")
+        .and_then(Value::as_str)
+        .ok_or_else(|| refusal("transport_required"))?;
+    let snapshot = cua_driver_core::session::session_snapshot(session, transport, Duration::ZERO)
+        .ok_or_else(|| refusal("lifecycle_unavailable"))?;
+    let guard = cua_driver_core::session::begin_session_dispatch(
+        session,
+        snapshot.public_label.as_deref(),
+        transport,
+        snapshot.implicit,
+        snapshot.transport,
+        snapshot.client_kind,
+    )
+    .map_err(|_| refusal("lifecycle_unavailable"))?;
+    Ok((transport.to_owned(), session.to_owned(), guard))
+}
+/// Exact existing runtime tree-only request. Other native Cua read modes retain
+/// their original actionable-tree semantics and never claim completeness here.
+pub(super) fn is_complete_request(args: &Value) -> bool {
+    let Some(object) = args.as_object() else {
+        return false;
+    };
+    args.get("include_screenshot").and_then(Value::as_bool) == Some(false)
+        && args
+            .get("include_accessibility_tree")
+            .and_then(Value::as_bool)
+            == Some(true)
+        && args.get("tree_format").and_then(Value::as_str) == Some("elements")
+        && args
+            .get("max_elements")
+            .and_then(Value::as_u64)
+            .is_some_and(|value| (1..=2048).contains(&value))
+        && args
+            .get("max_depth")
+            .and_then(Value::as_u64)
+            .is_some_and(|value| (1..=64).contains(&value))
+        && args
+            .get("timeout_ms")
+            .and_then(Value::as_u64)
+            .is_some_and(|value| (100..=2000).contains(&value))
+        && object.keys().all(|key| {
+            matches!(
+                key.as_str(),
+                "pid"
+                    | "window_id"
+                    | "include_screenshot"
+                    | "include_accessibility_tree"
+                    | "tree_format"
+                    | "max_elements"
+                    | "max_depth"
+                    | "timeout_ms"
+                    | "session"
+                    | "_session_id"
+                    | "_transport_session_id"
+                    | "_public_session_label"
+                    | "_session_idle_ttl_ms"
+            )
+        })
+}
+fn incomplete(code: &'static str) -> ToolResult {
+    ToolResult::error(code).with_structured(json!({
+        "schema":1,"code":code,"execution_certainty":"not_dispatched","uncertain":false,
+        "elements_complete":false,"degraded":true
+    }))
+}
+
+pub(super) async fn complete_snapshot(state: Arc<ToolState>, args: Value) -> ToolResult {
+    let (transport, session, lifecycle) = match lifecycle(&args) {
+        Ok(value) => value,
+        Err(error) => return error,
+    };
+    let (pid, window, max_elements, max_depth, timeout_ms) = match (
+        args.get("pid")
+            .and_then(Value::as_i64)
+            .and_then(|value| i32::try_from(value).ok()),
+        args.get("window_id")
+            .and_then(Value::as_u64)
+            .and_then(|value| u32::try_from(value).ok()),
+        args.get("max_elements").and_then(Value::as_u64),
+        args.get("max_depth").and_then(Value::as_u64),
+        args.get("timeout_ms").and_then(Value::as_u64),
+    ) {
+        (Some(pid), Some(window), Some(count), Some(depth), Some(timeout))
+            if pid > 0 && window > 0 && is_complete_request(&args) =>
+        {
+            (pid, window, count as usize, depth as usize, timeout)
+        }
+        _ => return incomplete("invalid_request"),
+    };
+    let revision = {
+        let mut slot = match state.styx_private_ax.slot.lock() {
+            Ok(value) => value,
+            Err(_) => return incomplete("target_cache_unavailable"),
+        };
+        slot.retire_snapshot();
+        match slot.advance() {
+            Ok(value) => value,
+            Err(error) => return error,
+        }
+    };
+    let native = match tokio::task::spawn_blocking(move || {
+        let _lifecycle = lifecycle;
+        native::capture(
+            pid,
+            window,
+            max_elements,
+            max_depth,
+            Instant::now() + Duration::from_millis(timeout_ms),
+        )
+    })
+    .await
+    {
+        Ok(Ok(value)) => Arc::new(value),
+        Ok(Err(code)) => return incomplete(code),
+        Err(_) => return incomplete("object_unavailable"),
+    };
+    let mut slot = match state.styx_private_ax.slot.lock() {
+        Ok(value) => value,
+        Err(_) => return incomplete("target_cache_unavailable"),
+    };
+    if slot.revision != revision || !native.valid() {
+        return incomplete("stale_observation");
+    }
+    // Session publication rejects a session ended while the blocking work ran.
+    let Some((id, invalidated)) = state.snapshots.publish_for_session(
+        pid,
+        u64::from(window),
+        native.payload(),
+        Some(&session),
+        None,
+    ) else {
+        return incomplete("lifecycle_unavailable");
+    };
+    let mut rows = native.rows.clone();
+    for (index, row) in rows.iter_mut().enumerate() {
+        row["element_token"] = json!(token_for(id, index));
+    }
+    let count = rows.len();
+    let data = json!({
+        "pid":pid,"window_id":window,"tree_format":"elements","snapshot_id":format_snapshot_id(id),
+        "elements":rows,"element_count":count,"total_element_count":count,"returned_element_count":count,
+        "elements_complete":true,"truncated":false,
+        "invalidated_snapshot_ids":invalidated.into_iter().map(format_snapshot_id).collect::<Vec<_>>(),
+        "native_identity":{"platform":"macos","pid":pid,"process_start_seconds":native.birth.0,
+            "process_start_microseconds":native.birth.1,"window_id":window,"object_binding":"retained_ax_objects",
+            "invalidation":"observed_ax_notifications","atomic_remote_generation":false}
+    });
+    slot.snapshot = Some(CachedSnapshot {
+        id,
+        transport,
+        session,
+        native,
+    });
+    ToolResult::text("private_complete_ax_snapshot").with_structured(data)
+}
+
+struct AcquireTool {
+    state: Arc<ToolState>,
+}
+static ACQUIRE_DEF: OnceLock<ToolDef> = OnceLock::new();
+#[async_trait]
+impl Tool for AcquireTool {
+    fn def(&self) -> &ToolDef {
+        ACQUIRE_DEF.get_or_init(|| ToolDef {
+            name:"styx_private_ax_acquire_editable_v1".into(),
+            description:"Private owned-transport exact snapshot EditableText target acquisition; no OS write authorization is granted.".into(),
+            input_schema:json!({"type":"object","required":["pid","window_id","element_token"],
+                "properties":{"pid":{"type":"integer","minimum":1,"maximum":4294967295u64},
+                "window_id":{"type":"integer","minimum":1},"element_token":{"type":"string","maxLength":64}},
+                "additionalProperties":false}),
