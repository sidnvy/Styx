+pub(crate) struct CompleteSnapshot {
+    pub(crate) pid: i32,
+    pub(crate) window_id: u32,
+    pub(crate) birth: (u64, u64),
+    pub(crate) session: SessionIdentity,
+    // Stop and join the observer before releasing any original AX objects.
+    fence: Fence,
+    window: RetainedElement,
+    pub(crate) elements: Vec<RetainedElement>,
+    pub(crate) rows: Vec<Value>,
+    captured: Instant,
+}
+impl CompleteSnapshot {
+    pub(crate) fn invalidate(&self) {
+        self.fence.invalidate();
+    }
+    pub(crate) fn valid(&self) -> bool {
+        self.captured.elapsed() < Duration::from_secs(30) && self.fence.valid()
+    }
+    pub(crate) fn payload(&self) -> AxSnapshot {
+        AxSnapshot {
+            elements: self
+                .elements
+                .iter()
+                .map(|element| {
+                    unsafe { CFRetain(raw(element).cast()) };
+                    element.as_ptr()
+                })
+                .collect(),
+        }
+    }
+    fn verify_session(&self) -> NativeResult<()> {
+        if let Err(error) = observation::revalidate(self.session) {
+            // A later successful read cannot revive this original observation.
+            // There is no fallback to another active user's desktop.
+            self.invalidate();
+            return Err(error.code());
+        }
+        Ok(())
+    }
+    fn verify(&self, deadline: Instant) -> NativeResult<()> {
+        self.verify_session()?;
+        if self.captured.elapsed() >= Duration::from_secs(30) {
+            return Err("target_expired");
+        }
+        if !self.fence.valid() {
+            return Err("target_invalidated");
+        }
+        check_time(deadline)?;
+        self.fence.watch(&self.window, &[], deadline)?;
+        if process_start_stamp(self.pid) != Some(self.birth) {
+            return Err("process_unavailable");
+        }
+        if !matches!(
+            crate::windows::resolve_window_owner(self.pid, self.window_id),
+            crate::windows::WindowOwner::SamePid
+        ) {
+            return Err("window_changed");
+        }
+        timeout(&self.window, deadline)?;
+        pid_matches(&self.window, self.pid)?;
+        if unsafe { ax_get_window_id(raw(&self.window)) } != Some(self.window_id) {
+            return Err("window_changed");
+        }
+        // Re-enumeration only checks identity; it never relocates the target.
+        // A reused CGWindowID pointing to another retained AX object is refused.
+        let current_window = exact_window(self.pid, self.window_id, deadline)?;
+        if !same_object(&self.window, &current_window) {
+            return Err("window_changed");
+        }
+        self.fence.watch(&self.window, &[], deadline)?;
+        check_time(deadline)?;
+        if !self.fence.valid() {
+            return Err("target_invalidated");
+        }
+        self.verify_session()?;
+        check_time(deadline)?;
+        Ok(())
+    }
+}
+
+fn exact_window(pid: i32, window_id: u32, deadline: Instant) -> NativeResult<RetainedElement> {
+    let app_ptr = unsafe { AXUIElementCreateApplication(pid) };
+    let app_owner = OwnedCf(app_ptr.cast());
+    if app_ptr.is_null() {
+        return Err("process_unavailable");
+    }
+    let app = unsafe { RetainedElement::retain(app_ptr as usize) };
+    drop(app_owner);
+    timeout(&app, deadline)?;
+    let windows = read_attr(&app, "AXWindows")?.ok_or("window_unavailable")?;
+    let mut selected = None;
+    for candidate in array_members(&windows, 2048)? {
+        timeout(&candidate, deadline)?;
+        pid_matches(&candidate, pid)?;
+        let actual_id = unsafe { ax_get_window_id(raw(&candidate)) }.ok_or("window_unavailable")?;
+        if actual_id == window_id && selected.replace(candidate).is_some() {
+            return Err("window_changed");
+        }
+    }
+    let window = selected.ok_or("window_unavailable")?;
+    Ok(window)
+}
+
+pub(crate) fn capture(
+    pid: i32,
+    window_id: u32,
+    max_elements: usize,
+    max_depth: usize,
+    deadline: Instant,
+) -> NativeResult<CompleteSnapshot> {
+    check_time(deadline)?;
+    let session = observation::observe_unlocked_current().map_err(|error| error.code())?;
+    check_time(deadline)?;
+    if !unsafe { AXIsProcessTrusted() } {
+        return Err("editable_unavailable");
+    }
+    let birth = process_start_stamp(pid).ok_or("process_unavailable")?;
+    if !matches!(
+        crate::windows::resolve_window_owner(pid, window_id),
+        crate::windows::WindowOwner::SamePid
+    ) {
+        return Err("window_unavailable");
+    }
+    let window = exact_window(pid, window_id, deadline)?;
+    let fence = Fence::start(pid, deadline)?;
+    fence.watch(
+        &window,
+        &[
+            "AXUIElementDestroyed",
+            "AXLayoutChanged",
+            "AXMoved",
+            "AXResized",
+        ],
+        deadline,
+    )?;
+    let mut elements = Vec::new();
+    let mut rows = Vec::new();
+    let mut stack = vec![(window.clone(), 0usize, None::<usize>)];
+    while let Some((element, depth, parent)) = stack.pop() {
+        check_time(deadline)?;
+        if !fence.valid() {
+            return Err("target_invalidated");
+        }
+        if elements.len() >= max_elements
+            || depth > max_depth
+            || elements.iter().any(|old| same_object(old, &element))
+        {
+            return Err("stale_observation");
+        }
+        timeout(&element, deadline)?;
+        pid_matches(&element, pid)?;
+        fence.watch(&element, &["AXUIElementDestroyed"], deadline)?;
+        let role = string_attr(&element, "AXRole")?
+            .filter(|role| !role.is_empty() && role.len() <= 256)
+            .ok_or("object_unavailable")?;
+        let label = string_attr(&element, "AXTitle")?;
+        let secure = string_attr(&element, "AXSubrole")?.as_deref() == Some("AXSecureTextField");
+        let value = if secure {
+            None
+        } else {
+            string_attr(&element, "AXValue")?
+        };
+        let index = elements.len();
+        let mut row = json!({"element_index":index,"role":role,"depth":depth});
+        if let Some(parent) = parent {
+            row["parent_index"] = json!(parent);
+        }
+        if let Some(label) = label {
+            row["label"] = json!(label);
+        }
+        if let Some(value) = value {
+            row["value"] = json!(value);
+        }
+        let descendants = children(
+            &element,
+            max_elements.saturating_sub(elements.len() + stack.len() + 1),
+        )?;
+        if depth == max_depth && !descendants.is_empty() {
+            return Err("stale_observation");
+        }
+        for child in descendants.into_iter().rev() {
+            stack.push((child, depth + 1, Some(index)));
+        }
+        elements.push(element);
+        rows.push(row);
+    }
+    if rows.is_empty()
+        || serde_json::to_vec(&rows)
+            .map_err(|_| "stale_observation")?
+            .len()
+            > 256 * 1024
+    {
+        return Err("stale_observation");
+    }
+    let snapshot = CompleteSnapshot {
+        pid,
+        window_id,
+        birth,
+        session,
+        elements,
+        rows,
+        window,
+        fence,
+        captured: Instant::now(),
+    };
+    snapshot.verify(deadline)?;
+    Ok(snapshot)
+}
+
+pub(crate) struct EditableTarget {
+    snapshot: Arc<CompleteSnapshot>,
+    element: RetainedElement,
+    original_value: String,
+}
+fn validate_editable(
+    snapshot: &CompleteSnapshot,
+    element: &RetainedElement,
+    expected: &str,
+    deadline: Instant,
+) -> NativeResult<()> {
+    snapshot.verify(deadline)?;
+    timeout(element, deadline)?;
+    pid_matches(element, snapshot.pid)?;
+    let role = string_attr(element, "AXRole")?.ok_or("editable_unavailable")?;
+    if !matches!(role.as_str(), "AXTextField" | "AXTextArea")
+        || string_attr(element, "AXSubrole")?.as_deref() == Some("AXSecureTextField")
+    {
+        return Err("editable_unavailable");
+    }
+    let window = read_attr(element, "AXWindow")?.ok_or("object_frame_mismatch")?;
+    if unsafe { CFGetTypeID(window.0) } != unsafe { AXUIElementGetTypeID() }
+        || unsafe { CFEqual(window.0, raw(&snapshot.window).cast()) } == 0
+    {
+        return Err("object_frame_mismatch");
+    }
+    if unsafe { copy_bool_attr(raw(element), "AXEnabled") } != Some(true) {
+        return Err("editable_unavailable");
+    }
+    if string_attr(element, "AXValue")?.as_deref() != Some(expected) {
+        return Err("target_identity_changed");
+    }
+    let name = CFString::new("AXValue");
+    let mut settable = 0;
+    if unsafe {
+        AXUIElementIsAttributeSettable(raw(element), name.as_concrete_TypeRef(), &mut settable)
+    } != kAXErrorSuccess
+        || settable == 0
+    {
+        return Err("editable_unavailable");
+    }
+    snapshot.fence.watch(element, &[], deadline)?;
+    check_time(deadline)?;
+    if !snapshot.fence.valid() {
+        return Err("target_invalidated");
+    }
+    Ok(())
+}
+pub(crate) fn acquire(
+    snapshot: Arc<CompleteSnapshot>,
+    row: usize,
+    element: RetainedElement,
+) -> NativeResult<EditableTarget> {
+    let deadline = Instant::now() + Duration::from_secs(3);
+    let original = snapshot.elements.get(row).ok_or("stale_observation")?;
+    if !same_object(original, &element) {
+        return Err("target_identity_changed");
+    }
+    let original_value = snapshot
+        .rows
+        .get(row)
+        .and_then(|v| v.get("value"))
+        .and_then(Value::as_str)
+        .ok_or("editable_unavailable")?
+        .to_owned();
+    snapshot
+        .fence
+        .watch(&element, &["AXValueChanged"], deadline)?;
+    validate_editable(&snapshot, &element, &original_value, deadline)?;
+    Ok(EditableTarget {
+        snapshot,
+        element,
+        original_value,
+    })
+}
+impl EditableTarget {
+    pub(crate) fn matches(&self, element: &RetainedElement) -> bool {
+        same_object(&self.element, element) && self.snapshot.valid()
+    }
+}
+pub(crate) enum WriteOutcome {
+    Acknowledged,
+    NotDispatched(&'static str),
+    Unknown,
+}
+pub(crate) fn set_text_once(
+    target: EditableTarget,
+    value: zeroize::Zeroizing<String>,
+) -> WriteOutcome {
+    let deadline = Instant::now() + Duration::from_secs(3);
+    if let Err(code) = validate_editable(
+        &target.snapshot,
+        &target.element,
+        &target.original_value,
+        deadline,
+    ) {
+        return WriteOutcome::NotDispatched(code);
+    }
+    // Re-read after AX validation, immediately before the one side effect.
+    // This remains an OS observation, not an atomic lock/action fence. A complete
+    // lock/unlock episode between observations cannot be inferred from a bool.
+    if let Err(code) = target.snapshot.verify_session() {
+        return WriteOutcome::NotDispatched(code);
+    }
+    if let Err(code) = check_time(deadline) {
+        return WriteOutcome::NotDispatched(code);
+    }
+    // Invalidate before the one side effect. No old snapshot/target survives an
+    // acknowledged, failed, or unknown write. No keyboard/focus/retry fallback.
+    target.snapshot.invalidate();
+    let code = unsafe { set_string_attr(raw(&target.element), "AXValue", value.as_str()) };
+    if code == kAXErrorSuccess {
+        WriteOutcome::Acknowledged
+    } else {
+        WriteOutcome::Unknown
+    }
+}
