+//! Fixed inherited descriptors supplied only by the signed App/Host launcher.
+//! No MCP request can select a descriptor/socket/daemon or replace this binding.
+use std::{
+    fs::File,
+    io::Write,
+    os::fd::FromRawFd,
+    os::unix::net::UnixStream,
+    sync::{Mutex, OnceLock},
+};
+const ENV: &str = "STYX_PRIVATE_OWNED_PROXY_V1";
+const CONTROL: i32 = 3;
+const REPORT: i32 = 4;
+static CONTROL_STREAM: OnceLock<Mutex<Option<UnixStream>>> = OnceLock::new();
+pub(super) fn requested() -> anyhow::Result<bool> {
+    match std::env::var(ENV) {
+        Ok(v) if v == "1" => Ok(true),
+        Err(std::env::VarError::NotPresent) => Ok(false),
+        _ => anyhow::bail!("private_proxy_mode_invalid"),
+    }
+}
+pub(super) struct OwnedProxy {
+    report: File,
+}
+impl OwnedProxy {
+    pub(super) fn prepare() -> anyhow::Result<Option<Self>> {
+        if !requested()? {
+            return Ok(None);
+        }
+        if crate::mcp_envelope::configured()? {
+            anyhow::bail!("private_proxy_envelope_unsupported")
+        }
+        // SAFETY: only fixed descriptors3/4 from our explicit launcher contract are
+        // adopted, once per fresh process. Validate their kernel kinds/access before
+        // assigning ownership. No caller number or pathname is interpreted here.
+        unsafe {
+            if libc::fcntl(CONTROL, libc::F_GETFD) < 0 || libc::fcntl(REPORT, libc::F_GETFD) < 0 {
+                anyhow::bail!("private_proxy_descriptors_missing")
+            }
+            let mut facts = std::mem::zeroed::<libc::stat>();
+            if libc::fstat(REPORT, &mut facts) != 0
+                || facts.st_mode & libc::S_IFMT != libc::S_IFIFO
+                || libc::fcntl(REPORT, libc::F_GETFL) & libc::O_ACCMODE != libc::O_WRONLY
+            {
+                anyhow::bail!("private_proxy_report_refused")
+            }
+        }
+        // SAFETY: fixed inherited handles have passed validation; ownership transfers
+        // once and is retained for the real control/drain and report lifetime.
+        let control = unsafe { UnixStream::from_raw_fd(CONTROL) };
+        cua_driver_core::daemon::bind_styx_private_control_peer(&control)?;
+        control.set_nonblocking(true)?;
+        CONTROL_STREAM
+            .set(Mutex::new(Some(control)))
+            .map_err(|_| anyhow::anyhow!("private_proxy_already_bound"))?;
+        let report = unsafe { File::from_raw_fd(REPORT) };
+        Ok(Some(Self { report }))
+    }
+    pub(super) fn record_drained(&mut self) -> anyhow::Result<()> {
+        // Written ONLY after the real original-control drain ACK, never exit status.
+        self.report.write_all(
+            b"{\"schema\":1,\"source\":\"original_control_transport\",\"drained\":true}\n",
+        )?;
+        self.report.flush()?;
+        Ok(())
+    }
+}
+pub(super) fn take_control() -> anyhow::Result<Option<tokio::net::UnixStream>> {
+    if !requested()? {
+        return Ok(None);
+    }
+    let stream = CONTROL_STREAM
+        .get()
+        .ok_or_else(|| anyhow::anyhow!("private_proxy_not_bound"))?
+        .lock()
+        .map_err(|_| anyhow::anyhow!("private_proxy_state_unknown"))?
+        .take()
+        .ok_or_else(|| anyhow::anyhow!("private_proxy_control_consumed"))?;
+    // No reconnect: original retainedFD peer is rechecked immediately at adoption.
+    cua_driver_core::daemon::check_styx_private_peer(&stream)?;
+    Ok(Some(tokio::net::UnixStream::from_std(stream)?))
+}
