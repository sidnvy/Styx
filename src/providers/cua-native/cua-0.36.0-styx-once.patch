+            &*au.ptr::<TOKEN_USER>(),
+            &*bu.ptr::<TOKEN_USER>(),
+            &*az.ptr::<TOKEN_STATISTICS>(),
+            &*bz.ptr::<TOKEN_STATISTICS>(),
+        )
+    };
+    if !unsafe { EqualSid(auser.User.Sid, buser.User.Sid) }.is_ok()
+        || astat.AuthenticationId != bstat.AuthenticationId
+        || session(a)? != session(b)?
+        || integrity(b)? > integrity(a)?
+    {
+        return Err("unproven_object_owner");
+    }
+    Ok(())
+}
+fn name(handle: HANDLE) -> NativeResult<String> {
+    let mut buf = [0u16; 256];
+    let mut used = 0;
+    unsafe {
+        GetUserObjectInformationW(
+            handle,
+            UOI_NAME,
+            Some(buf.as_mut_ptr().cast()),
+            (buf.len() * 2) as u32,
+            Some(&mut used),
+        )
+    }
+    .map_err(|_| "session_unknown")?;
+    if used < 2 || used > 512 || used % 2 != 0 || buf[used as usize / 2 - 1] != 0 {
+        return Err("session_unknown");
+    }
+    String::from_utf16(&buf[..used as usize / 2 - 1]).map_err(|_| "session_unknown")
+}
+fn input(desktop: HDESK) -> NativeResult<()> {
+    let mut yes = BOOL(0);
+    let mut used = 0;
+    unsafe {
+        GetUserObjectInformationW(
+            HANDLE(desktop.0),
+            UOI_IO,
+            Some((&mut yes as *mut BOOL).cast()),
+            size_of::<BOOL>() as u32,
+            Some(&mut used),
+        )
+    }
+    .map_err(|_| "session_unknown")?;
+    if used != size_of::<BOOL>() as u32 || !yes.as_bool() {
+        return Err("session_locked");
+    }
+    Ok(())
+}
+#[derive(Clone, Copy, PartialEq, Eq)]
+struct Session {
+    session: u32,
+    logon: i64,
+    connect: i64,
+}
+fn unlocked(session: u32) -> NativeResult<Session> {
+    if session == 0 {
+        return Err("session_unknown");
+    }
+    let mut buffer = PWSTR::null();
+    let mut count = 0;
+    unsafe {
+        WTSQuerySessionInformationW(
+            WTS_CURRENT_SERVER_HANDLE,
+            session,
+            WTSSessionInfoEx,
+            &mut buffer,
+            &mut count,
+        )
+    }
+    .map_err(|_| "session_unknown")?;
+    struct Buffer(PWSTR);
+    impl Drop for Buffer {
+        fn drop(&mut self) {
+            unsafe {
+                WTSFreeMemory(self.0 .0.cast());
+            }
+        }
+    }
+    let _owner = Buffer(buffer);
+    if buffer.is_null() || count as usize != size_of::<WTSINFOEXW>() {
+        return Err("session_unknown");
+    }
+    let data = unsafe { &*buffer.0.cast::<WTSINFOEXW>() };
+    if data.Level != 1 {
+        return Err("session_unknown");
+    }
+    let row = unsafe { data.Data.WTSInfoExLevel1 };
+    if row.SessionId != session || row.SessionState != WTSActive {
+        return Err("session_disconnected");
+    }
+    if row.SessionFlags as u32 == WTS_SESSIONSTATE_LOCK {
+        return Err("session_locked");
+    }
+    if row.SessionFlags as u32 != WTS_SESSIONSTATE_UNLOCK
+        || row.LogonTime <= 0
+        || row.ConnectTime <= 0
+    {
+        return Err("session_unknown");
+    }
+    Ok(Session {
+        session,
+        logon: row.LogonTime,
+        connect: row.ConnectTime,
+    })
+}
+fn birth(handle: HANDLE) -> NativeResult<u64> {
+    let (mut created, mut exit, mut kernel, mut user): (FILETIME, FILETIME, FILETIME, FILETIME) =
+        unsafe { zeroed() };
+    unsafe { GetProcessTimes(handle, &mut created, &mut exit, &mut kernel, &mut user) }
+        .map_err(|_| "process_unavailable")?;
+    if exit.dwLowDateTime != 0 || exit.dwHighDateTime != 0 {
+        return Err("process_unavailable");
+    }
+    Ok((u64::from(created.dwHighDateTime) << 32) | u64::from(created.dwLowDateTime))
+}
+struct Enumeration {
+    target: HWND,
+    pid: u32,
+    seen: bool,
+    overflow: bool,
+    count: usize,
+}
+unsafe extern "system" fn visit(window: HWND, param: LPARAM) -> BOOL {
+    let state = unsafe { &mut *(param.0 as *mut Enumeration) };
+    state.count += 1;
+    if state.count > 4096 {
+        state.overflow = true;
+        return BOOL(0);
+    }
+    if window == state.target {
+        let mut pid = 0;
+        unsafe {
+            GetWindowThreadProcessId(window, Some(&mut pid));
+        }
+        state.seen = pid == state.pid;
+    }
+    BOOL(1)
+}
+pub(super) struct WindowBinding {
+    pid: i32,
+    window: u64,
+    process: Handle,
+    token: Handle,
+    current: Handle,
+    desktop: Desktop,
+    session: Session,
+    birth: u64,
+    original_current_token: TokenStamp,
+    original_target_token: TokenStamp,
+}
+impl WindowBinding {
+    pub(super) fn open(pid: i32, window: u64) -> NativeResult<Self> {
+        if pid <= 0 || window == 0 || window > usize::MAX as u64 {
+            return Err("window_unavailable");
+        }
+        let process = Handle(
+            unsafe { OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, false, pid as u32) }
+                .map_err(|_| "process_unavailable")?,
+        );
+        let target_token = token(process.0)?;
+        let current = token(unsafe { GetCurrentProcess() })?;
+        principal_matches(current.0, target_token.0)?;
+        let session = unlocked(session(current.0)?)?;
+        let station = unsafe { GetProcessWindowStation() }.map_err(|_| "session_unknown")?;
+        if name(HANDLE(station.0))? != "WinSta0" {
+            return Err("session_unknown");
+        }
+        let desktop = Desktop(
+            unsafe { OpenInputDesktop(DESKTOP_CONTROL_FLAGS(0), false, DESKTOP_READOBJECTS) }
+                .map_err(|_| "session_unknown")?,
+        );
+        if name(HANDLE(desktop.0 .0))? != "Default" {
+            return Err("session_locked");
+        }
+        input(desktop.0)?;
+        let birth = birth(process.0)?;
+        let original_current_token = token_stamp(current.0)?;
+        let original_target_token = token_stamp(target_token.0)?;
+        let result = Self {
+            pid,
+            window,
+            process,
+            token: target_token,
+            current,
+            desktop,
+            session,
+            birth,
+            original_current_token,
+            original_target_token,
+        };
+        result.verify()?;
+        Ok(result)
+    }
+    pub(super) fn pid(&self) -> i32 {
+        self.pid
+    }
+    pub(super) fn hwnd(&self) -> HWND {
+        HWND(self.window as usize as *mut c_void)
+    }
+    pub(super) fn birth(&self) -> u64 {
+        self.birth
+    }
+    pub(super) fn verify(&self) -> NativeResult<()> {
+        if birth(self.process.0)? != self.birth {
+            return Err("process_unavailable");
+        }
+        // Reopen the primary token of each original still-live process. A held
+        // old token alone does not detect replacement or privilege mutation.
+        let current = token(unsafe { GetCurrentProcess() })?;
+        let target = token(self.process.0)?;
+        if token_stamp(current.0)? != self.original_current_token
+            || token_stamp(target.0)? != self.original_target_token
+        {
+            return Err("session_changed");
+        }
+        principal_matches(current.0, target.0)?;
+        principal_matches(self.current.0, self.token.0)?;
+        if unlocked(self.session.session)? != self.session {
+            return Err("session_disconnected");
+        }
+        input(self.desktop.0)?;
+        let mut enumeration = Enumeration {
+            target: self.hwnd(),
+            pid: self.pid as u32,
+            seen: false,
+            overflow: false,
+            count: 0,
+        };
+        let result = unsafe {
+            EnumDesktopWindows(
+                self.desktop.0,
+                Some(visit),
+                LPARAM((&mut enumeration as *mut Enumeration) as isize),
+            )
+        };
+        if enumeration.overflow {
+            return Err("session_unknown");
+        }
+        result.map_err(|_| "session_unknown")?;
+        if !enumeration.seen {
+            return Err("window_changed");
+        }
+        if unlocked(self.session.session)? != self.session {
+            return Err("session_disconnected");
+        }
+        input(self.desktop.0)
+    }
+}
