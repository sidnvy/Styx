+//! Restricted Styx AX path. It retains original AX objects; it never relocates
+//! a target by row number, parent traversal, keyboard focus, or remote token.
+//! AX notifications are an observed invalidation fence, not an atomic remote
+//! object generation. Unsupported notifications make this path unavailable.
+
+use super::{
+    bindings::*,
+    enablement::process_start_stamp,
+    snapshot::{AxSnapshot, RetainedElement},
+};
+use crate::session::observation::{self, SessionIdentity};
+use core_foundation::{
+    array::{CFArrayGetCount, CFArrayGetTypeID, CFArrayGetValueAtIndex, CFArrayRef},
+    base::{CFEqual, CFGetTypeID, CFRelease, CFRetain, CFTypeRef, TCFType},
+    string::{CFString, CFStringGetLength, CFStringGetTypeID, CFStringRef},
+};
+use serde_json::{json, Value};
+use std::{
+    ffi::c_void,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        mpsc, Arc,
+    },
+    thread,
+    time::{Duration, Instant},
+};
+
+type NativeResult<T> = Result<T, &'static str>;
+type ObserverRef = *mut c_void;
+type RunLoopRef = *mut c_void;
+type RunLoopSourceRef = *mut c_void;
+type ObserverCallback = unsafe extern "C" fn(ObserverRef, AXUIElementRef, CFStringRef, *mut c_void);
+#[link(name = "ApplicationServices", kind = "framework")]
+unsafe extern "C" {
+    fn AXUIElementGetPid(element: AXUIElementRef, pid: *mut i32) -> AXError;
+    fn AXUIElementGetAttributeValueCount(
+        element: AXUIElementRef,
+        attribute: CFStringRef,
+        count: *mut isize,
+    ) -> AXError;
+    fn AXUIElementCopyAttributeValues(
+        element: AXUIElementRef,
+        attribute: CFStringRef,
+        index: isize,
+        max_values: isize,
+        values: *mut CFArrayRef,
+    ) -> AXError;
+    fn AXObserverCreate(
+        pid: i32,
+        callback: ObserverCallback,
+        observer: *mut ObserverRef,
+    ) -> AXError;
+    fn AXObserverAddNotification(
+        observer: ObserverRef,
+        element: AXUIElementRef,
+        notification: CFStringRef,
+        context: *mut c_void,
+    ) -> AXError;
+    fn AXObserverGetRunLoopSource(observer: ObserverRef) -> RunLoopSourceRef;
+}
+#[link(name = "CoreFoundation", kind = "framework")]
+unsafe extern "C" {
+    static kCFRunLoopDefaultMode: CFStringRef;
+    fn CFRunLoopGetCurrent() -> RunLoopRef;
+    fn CFRunLoopAddSource(run_loop: RunLoopRef, source: RunLoopSourceRef, mode: CFStringRef);
+    fn CFRunLoopRemoveSource(run_loop: RunLoopRef, source: RunLoopSourceRef, mode: CFStringRef);
+    fn CFRunLoopRunInMode(mode: CFStringRef, seconds: f64, return_after_source_handled: u8) -> i32;
+}
+
+/// Own any returned +1 CF value, including on an AX error path.
+struct OwnedCf(CFTypeRef);
+impl Drop for OwnedCf {
+    fn drop(&mut self) {
+        if !self.0.is_null() {
+            unsafe { CFRelease(self.0) };
+        }
+    }
+}
+fn raw(element: &RetainedElement) -> AXUIElementRef {
+    element.as_ptr() as AXUIElementRef
+}
+pub(crate) fn same_object(a: &RetainedElement, b: &RetainedElement) -> bool {
+    unsafe { CFEqual(raw(a).cast(), raw(b).cast()) != 0 }
+}
+fn check_time(deadline: Instant) -> NativeResult<()> {
+    if Instant::now() >= deadline {
+        Err("validation_timeout")
+    } else {
+        Ok(())
+    }
+}
+fn timeout(element: &RetainedElement, deadline: Instant) -> NativeResult<()> {
+    check_time(deadline)?;
+    let remaining = deadline
+        .saturating_duration_since(Instant::now())
+        .as_secs_f32();
+    if unsafe { AXUIElementSetMessagingTimeout(raw(element), remaining) } != kAXErrorSuccess {
+        return Err("object_unavailable");
+    }
+    Ok(())
+}
+fn pid_matches(element: &RetainedElement, pid: i32) -> NativeResult<()> {
+    let mut actual = 0;
+    if unsafe { AXUIElementGetPid(raw(element), &mut actual) } != kAXErrorSuccess || actual != pid {
+        Err("unproven_object_owner")
+    } else {
+        Ok(())
+    }
+}
+fn read_attr(element: &RetainedElement, name: &str) -> NativeResult<Option<OwnedCf>> {
+    let name = CFString::new(name);
+    let mut value = std::ptr::null();
+    let code = unsafe {
+        AXUIElementCopyAttributeValue(raw(element), name.as_concrete_TypeRef(), &mut value)
+    };
+    let owned = OwnedCf(value);
+    match code {
+        kAXErrorSuccess if !value.is_null() => Ok(Some(owned)),
+        kAXErrorAttributeUnsupported | kAXErrorNoValue => Ok(None),
+        _ => Err("object_unavailable"),
+    }
+}
+fn string_attr(element: &RetainedElement, name: &str) -> NativeResult<Option<String>> {
+    let Some(value) = read_attr(element, name)? else {
+        return Ok(None);
+    };
+    if unsafe { CFGetTypeID(value.0) } != unsafe { CFStringGetTypeID() } {
+        return Ok(None);
+    }
+    if unsafe { CFStringGetLength(value.0.cast()) } > 4096 {
+        return Err("stale_observation");
+    }
+    let text = unsafe { CFString::wrap_under_get_rule(value.0.cast()) }.to_string();
+    Ok(Some(text))
+}
+fn array_members(value: &OwnedCf, limit: usize) -> NativeResult<Vec<RetainedElement>> {
+    if unsafe { CFGetTypeID(value.0) } != unsafe { CFArrayGetTypeID() } {
+        return Err("object_unavailable");
+    }
+    let array = value.0 as CFArrayRef;
+    let count = unsafe { CFArrayGetCount(array) };
+    if count < 0 || count as usize > limit {
+        return Err("stale_observation");
+    }
+    let mut result = Vec::with_capacity(count as usize);
+    for index in 0..count {
+        let item = unsafe { CFArrayGetValueAtIndex(array, index) };
+        if item.is_null() || unsafe { CFGetTypeID(item) } != unsafe { AXUIElementGetTypeID() } {
+            return Err("object_unavailable");
+        }
+        result.push(unsafe { RetainedElement::retain(item as usize) });
+    }
+    Ok(result)
+}
+/// An unsupported AXChildren is a leaf only when the object's own successfully
+/// copied attribute-name list confirms that the attribute is absent.
+fn confirms_leaf(element: &RetainedElement) -> NativeResult<bool> {
+    let mut array = std::ptr::null();
+    let code = unsafe { AXUIElementCopyAttributeNames(raw(element), &mut array) };
+    let owned = OwnedCf(array.cast());
+    if code != kAXErrorSuccess
+        || owned.0.is_null()
+        || unsafe { CFGetTypeID(owned.0) } != unsafe { CFArrayGetTypeID() }
+    {
+        return Err("object_unavailable");
+    }
+    let count = unsafe { CFArrayGetCount(array) };
+    if !(0..=256).contains(&count) {
+        return Err("object_unavailable");
+    }
+    let children = CFString::new("AXChildren");
+    for index in 0..count {
+        let item = unsafe { CFArrayGetValueAtIndex(array, index) };
+        if item.is_null() || unsafe { CFGetTypeID(item) } != unsafe { CFStringGetTypeID() } {
+            return Err("object_unavailable");
+        }
+        if unsafe { CFEqual(item, children.as_CFTypeRef()) } != 0 {
+            return Ok(false);
+        }
+    }
+    Ok(true)
+}
+fn children(element: &RetainedElement, limit: usize) -> NativeResult<Vec<RetainedElement>> {
+    let name = CFString::new("AXChildren");
+    let mut count = 0;
+    let code = unsafe {
+        AXUIElementGetAttributeValueCount(raw(element), name.as_concrete_TypeRef(), &mut count)
+    };
+    if code == kAXErrorAttributeUnsupported && confirms_leaf(element)? {
+        return Ok(Vec::new());
+    }
+    if code != kAXErrorSuccess || count < 0 {
+        return Err("object_unavailable");
+    }
+    if count as usize > limit {
+        return Err("stale_observation");
+    }
+    if count == 0 {
+        return Ok(Vec::new());
+    }
+    let mut array = std::ptr::null();
+    let code = unsafe {
+        AXUIElementCopyAttributeValues(
+            raw(element),
+            name.as_concrete_TypeRef(),
+            0,
+            count,
+            &mut array,
+        )
+    };
+    let owned = OwnedCf(array.cast());
+    if code != kAXErrorSuccess || owned.0.is_null() {
+        return Err("object_unavailable");
+    }
+    let result = array_members(&owned, limit)?;
+    let mut after = 0;
+    if result.len() != count as usize
+        || unsafe {
+            AXUIElementGetAttributeValueCount(raw(element), name.as_concrete_TypeRef(), &mut after)
+        } != kAXErrorSuccess
+        || after != count
+    {
+        return Err("stale_observation");
+    }
+    Ok(result)
+}
+
+struct FenceState {
+    invalid: AtomicBool,
+    stop: AtomicBool,
+}
+struct Watch {
+    element: RetainedElement,
+    names: Vec<&'static str>,
+    result: mpsc::SyncSender<NativeResult<()>>,
+}
+pub(crate) struct Fence {
+    state: Arc<FenceState>,
+    commands: mpsc::Sender<Watch>,
+    thread: Option<thread::JoinHandle<()>>,
+}
+unsafe extern "C" fn changed(
+    _: ObserverRef,
+    _: AXUIElementRef,
+    _: CFStringRef,
+    context: *mut c_void,
+) {
+    // Context is the thread-owned Arc allocation, kept alive until source removal
+    // and observer release. The callback never accesses the target or Rust locks.
+    if !context.is_null() {
+        unsafe { &*(context as *const FenceState) }
+            .invalid
+            .store(true, Ordering::Release);
+    }
+}
+impl Fence {
+    fn start(pid: i32, deadline: Instant) -> NativeResult<Self> {
+        let state = Arc::new(FenceState {
+            invalid: AtomicBool::new(false),
+            stop: AtomicBool::new(false),
+        });
+        let thread_state = state.clone();
+        let (commands, incoming) = mpsc::channel::<Watch>();
+        let (ready_tx, ready_rx) = mpsc::sync_channel(1);
+        let thread = thread::Builder::new()
+            .name("styx-ax-fence".into())
+            .spawn(move || {
+                let mut observer = std::ptr::null_mut();
+                if unsafe { AXObserverCreate(pid, changed, &mut observer) } != kAXErrorSuccess
+                    || observer.is_null()
+                {
+                    thread_state.invalid.store(true, Ordering::Release);
+                    if !observer.is_null() {
+                        unsafe { CFRelease(observer.cast()) };
+                    }
+                    let _ = ready_tx.send(Err("target_invalidated"));
+                    return;
+                }
+                let observer_owner = OwnedCf(observer.cast());
+                let source = unsafe { AXObserverGetRunLoopSource(observer) };
+                if source.is_null() {
+                    let _ = ready_tx.send(Err("target_invalidated"));
+                    return;
+                }
+                let run_loop = unsafe { CFRunLoopGetCurrent() };
+                unsafe { CFRunLoopAddSource(run_loop, source, kCFRunLoopDefaultMode) };
+                let _ = ready_tx.send(Ok(()));
+                while !thread_state.stop.load(Ordering::Acquire) {
+                    while let Ok(command) = incoming.try_recv() {
+                        let mut result = Ok(());
+                        for name in command.names {
+                            let name = CFString::new(name);
+                            let code = unsafe {
+                                AXObserverAddNotification(
+                                    observer,
+                                    raw(&command.element),
+                                    name.as_concrete_TypeRef(),
+                                    Arc::as_ptr(&thread_state) as *mut c_void,
+                                )
+                            };
+                            // Already registered is safe only on this exact observer/object.
+                            if code != kAXErrorSuccess && code != -25209 {
+                                thread_state.invalid.store(true, Ordering::Release);
+                                result = Err("target_invalidated");
+                                break;
+                            }
+                        }
+                        // Drain already queued source events before acknowledging a
+                        // registration/barrier. An event storm is not a healthy fence.
+                        let mut drained = false;
+                        for _ in 0..64 {
+                            if unsafe { CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.0, 1) } != 4 {
+                                drained = true;
+                                break;
+                            }
+                        }
+                        if !drained || thread_state.invalid.load(Ordering::Acquire) {
+                            thread_state.invalid.store(true, Ordering::Release);
+                            result = Err("target_invalidated");
+                        }
+                        let _ = command.result.send(result);
+                    }
+                    unsafe { CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.01, 1) };
+                }
+                thread_state.invalid.store(true, Ordering::Release);
+                unsafe { CFRunLoopRemoveSource(run_loop, source, kCFRunLoopDefaultMode) };
+                drop(observer_owner);
+                // thread_state (the callback context) outlives observer teardown.
+            })
+            .map_err(|_| "target_cache_unavailable")?;
+        let fence = Self {
+            state,
+            commands,
+            thread: Some(thread),
+        };
+        ready_rx
+            .recv_timeout(deadline.saturating_duration_since(Instant::now()))
+            .map_err(|_| "validation_timeout")??;
+        Ok(fence)
+    }
+    pub(crate) fn invalidate(&self) {
+        self.state.invalid.store(true, Ordering::Release);
+    }
+    pub(crate) fn valid(&self) -> bool {
+        !self.state.invalid.load(Ordering::Acquire)
+            && self
+                .thread
+                .as_ref()
+                .is_some_and(|thread| !thread.is_finished())
+    }
+    fn watch(
+        &self,
+        element: &RetainedElement,
+        names: &[&'static str],
+        deadline: Instant,
+    ) -> NativeResult<()> {
+        if !self.valid() {
+            return Err("target_invalidated");
+        }
+        let (result, receiver) = mpsc::sync_channel(1);
+        self.commands
+            .send(Watch {
+                element: element.clone(),
+                names: names.to_vec(),
+                result,
+            })
+            .map_err(|_| "target_invalidated")?;
+        receiver
+            .recv_timeout(deadline.saturating_duration_since(Instant::now()))
+            .map_err(|_| "validation_timeout")??;
+        if self.valid() {
+            Ok(())
+        } else {
+            Err("target_invalidated")
+        }
+    }
+}
+impl Drop for Fence {
+    fn drop(&mut self) {
+        self.invalidate();
+        self.state.stop.store(true, Ordering::Release);
+        if let Some(thread) = self.thread.take() {
+            let _ = thread.join();
+        }
+    }
+}
+
+pub(crate) struct CompleteSnapshot {
+    pub(crate) pid: i32,
+    pub(crate) window_id: u32,
+    pub(crate) birth: (u64, u64),
+    pub(crate) session: SessionIdentity,
+    // Stop and join the observer before releasing any original AX objects.
+    fence: Fence,
+    window: RetainedElement,
+    pub(crate) elements: Vec<RetainedElement>,
+    pub(crate) rows: Vec<Value>,
+    captured: Instant,
+}
+impl CompleteSnapshot {
+    pub(crate) fn invalidate(&self) {
+        self.fence.invalidate();
+    }
+    pub(crate) fn valid(&self) -> bool {
+        self.captured.elapsed() < Duration::from_secs(30) && self.fence.valid()
+    }
+    pub(crate) fn payload(&self) -> AxSnapshot {
+        AxSnapshot {
+            elements: self
+                .elements
+                .iter()
+                .map(|element| {
+                    unsafe { CFRetain(raw(element).cast()) };
+                    element.as_ptr()
+                })
+                .collect(),
+        }
+    }
+    fn verify_session(&self) -> NativeResult<()> {
+        if let Err(error) = observation::revalidate(self.session) {
+            // A later successful read cannot revive this original observation.
+            // There is no fallback to another active user's desktop.
+            self.invalidate();
+            return Err(error.code());
+        }
+        Ok(())
+    }
+    fn verify(&self, deadline: Instant) -> NativeResult<()> {
+        self.verify_session()?;
+        if self.captured.elapsed() >= Duration::from_secs(30) {
+            return Err("target_expired");
+        }
+        if !self.fence.valid() {
+            return Err("target_invalidated");
+        }
+        check_time(deadline)?;
+        self.fence.watch(&self.window, &[], deadline)?;
+        if process_start_stamp(self.pid) != Some(self.birth) {
+            return Err("process_unavailable");
+        }
+        if !matches!(
+            crate::windows::resolve_window_owner(self.pid, self.window_id),
+            crate::windows::WindowOwner::SamePid
+        ) {
+            return Err("window_changed");
+        }
+        timeout(&self.window, deadline)?;
+        pid_matches(&self.window, self.pid)?;
+        if unsafe { ax_get_window_id(raw(&self.window)) } != Some(self.window_id) {
+            return Err("window_changed");
+        }
+        // Re-enumeration only checks identity; it never relocates the target.
+        // A reused CGWindowID pointing to another retained AX object is refused.
+        let current_window = exact_window(self.pid, self.window_id, deadline)?;
+        if !same_object(&self.window, &current_window) {
+            return Err("window_changed");
+        }
+        self.fence.watch(&self.window, &[], deadline)?;
+        check_time(deadline)?;
+        if !self.fence.valid() {
+            return Err("target_invalidated");
+        }
+        self.verify_session()?;
+        check_time(deadline)?;
+        Ok(())
+    }
+}
+
+fn exact_window(pid: i32, window_id: u32, deadline: Instant) -> NativeResult<RetainedElement> {
+    let app_ptr = unsafe { AXUIElementCreateApplication(pid) };
+    let app_owner = OwnedCf(app_ptr.cast());
+    if app_ptr.is_null() {
+        return Err("process_unavailable");
+    }
+    let app = unsafe { RetainedElement::retain(app_ptr as usize) };
+    drop(app_owner);
+    timeout(&app, deadline)?;
+    let windows = read_attr(&app, "AXWindows")?.ok_or("window_unavailable")?;
+    let mut selected = None;
+    for candidate in array_members(&windows, 2048)? {
+        timeout(&candidate, deadline)?;
+        pid_matches(&candidate, pid)?;
+        let actual_id = unsafe { ax_get_window_id(raw(&candidate)) }.ok_or("window_unavailable")?;
+        if actual_id == window_id && selected.replace(candidate).is_some() {
+            return Err("window_changed");
+        }
+    }
+    let window = selected.ok_or("window_unavailable")?;
+    Ok(window)
+}
+
+pub(crate) fn capture(
+    pid: i32,
+    window_id: u32,
+    max_elements: usize,
+    max_depth: usize,
+    deadline: Instant,
+) -> NativeResult<CompleteSnapshot> {
+    check_time(deadline)?;
+    let session = observation::observe_unlocked_current().map_err(|error| error.code())?;
+    check_time(deadline)?;
+    if !unsafe { AXIsProcessTrusted() } {
+        return Err("editable_unavailable");
+    }
+    let birth = process_start_stamp(pid).ok_or("process_unavailable")?;
+    if !matches!(
+        crate::windows::resolve_window_owner(pid, window_id),
+        crate::windows::WindowOwner::SamePid
+    ) {
+        return Err("window_unavailable");
+    }
+    let window = exact_window(pid, window_id, deadline)?;
+    let fence = Fence::start(pid, deadline)?;
+    fence.watch(
+        &window,
+        &[
+            "AXUIElementDestroyed",
+            "AXLayoutChanged",
+            "AXMoved",
+            "AXResized",
+        ],
+        deadline,
+    )?;
+    let mut elements = Vec::new();
+    let mut rows = Vec::new();
+    let mut stack = vec![(window.clone(), 0usize, None::<usize>)];
+    while let Some((element, depth, parent)) = stack.pop() {
+        check_time(deadline)?;
+        if !fence.valid() {
+            return Err("target_invalidated");
+        }
+        if elements.len() >= max_elements
+            || depth > max_depth
+            || elements.iter().any(|old| same_object(old, &element))
+        {
+            return Err("stale_observation");
+        }
+        timeout(&element, deadline)?;
+        pid_matches(&element, pid)?;
+        fence.watch(&element, &["AXUIElementDestroyed"], deadline)?;
+        let role = string_attr(&element, "AXRole")?
+            .filter(|role| !role.is_empty() && role.len() <= 256)
+            .ok_or("object_unavailable")?;
+        let label = string_attr(&element, "AXTitle")?;
+        let secure = string_attr(&element, "AXSubrole")?.as_deref() == Some("AXSecureTextField");
+        let value = if secure {
+            None
+        } else {
+            string_attr(&element, "AXValue")?
+        };
