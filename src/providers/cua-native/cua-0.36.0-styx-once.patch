+// Private owned-proxy mode binds every real one-shot request to the original
+// inherited control socket's exact kernel peer, before writing request bytes.
+#[cfg(target_os = "macos")]
+#[derive(Clone, PartialEq, Eq)]
+struct StyxPeer {
+    uid: u32,
+    pid: libc::pid_t,
+    token: [u8; 32],
+}
+#[cfg(target_os = "macos")]
+static STYX_PEER: std::sync::OnceLock<StyxPeer> = std::sync::OnceLock::new();
+#[cfg(target_os = "macos")]
+fn styx_peer(stream: &std::os::unix::net::UnixStream) -> anyhow::Result<StyxPeer> {
+    use std::os::fd::AsRawFd;
+    let mut uid = 0;
+    let mut gid = 0;
+    let mut pid: libc::pid_t = 0;
+    let mut token = [0u8; 32];
+    let mut pid_len = std::mem::size_of_val(&pid) as libc::socklen_t;
+    let mut token_len = token.len() as libc::socklen_t;
+    // SAFETY: official libc socket APIs receive live connected FD, valid output
+    // pointers and exact mutable sizes. Audit token is compared as opaque kernel
+    // bytes; no field layout or PID-only identity is invented.
+    unsafe {
+        if libc::getpeereid(stream.as_raw_fd(), &mut uid, &mut gid) != 0
+            || libc::getsockopt(
+                stream.as_raw_fd(),
+                libc::SOL_LOCAL,
+                libc::LOCAL_PEERPID,
+                (&mut pid as *mut libc::pid_t).cast(),
+                &mut pid_len,
+            ) != 0
+            || libc::getsockopt(
+                stream.as_raw_fd(),
+                libc::SOL_LOCAL,
+                libc::LOCAL_PEERTOKEN,
+                token.as_mut_ptr().cast(),
+                &mut token_len,
+            ) != 0
+            || pid_len as usize != std::mem::size_of_val(&pid)
+            || token_len as usize != token.len()
+            || uid != libc::getuid()
+            || uid != libc::geteuid()
+            || pid <= 0
+        {
+            anyhow::bail!("private_proxy_peer_refused")
+        }
+    }
+    Ok(StyxPeer { uid, pid, token })
+}
+#[cfg(target_os = "macos")]
+pub fn bind_styx_private_control_peer(
+    stream: &std::os::unix::net::UnixStream,
+) -> anyhow::Result<()> {
+    if std::env::var("STYX_PRIVATE_OWNED_PROXY_V1").as_deref() != Ok("1") {
+        anyhow::bail!("private_proxy_not_selected")
+    }
+    STYX_PEER
+        .set(styx_peer(stream)?)
+        .map_err(|_| anyhow::anyhow!("private_proxy_already_bound"))
+}
+#[cfg(target_os = "macos")]
+pub fn check_styx_private_peer(stream: &std::os::unix::net::UnixStream) -> anyhow::Result<()> {
+    match std::env::var("STYX_PRIVATE_OWNED_PROXY_V1") {
+        Err(std::env::VarError::NotPresent) => return Ok(()),
+        Ok(value) if value == "1" => {}
+        _ => anyhow::bail!("private_proxy_mode_invalid"),
+    }
+    let expected = STYX_PEER
+        .get()
+        .ok_or_else(|| anyhow::anyhow!("private_proxy_not_bound"))?;
+    if &styx_peer(stream)? != expected {
+        anyhow::bail!("private_proxy_peer_changed")
+    }
+    Ok(())
+}
