+//! Read-only facts for the authenticated local embedded daemon connection.
+//! No registry registration, grant, prompt, input, or claim of Desktop Ready.
+
+use super::observation;
+use crate::{ax::enablement::process_start_stamp, permissions::current_status};
+use serde::Serialize;
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Arc,
+};
+use tokio::{sync::Mutex, task::JoinHandle};
+
+type ObservationResult = Result<NativeObservation, &'static str>;
+
+#[derive(Clone, Copy, Eq, PartialEq, Serialize)]
+pub struct ProcessBirth {
+    pub pid: u32,
+    pub start_seconds: u64,
+    pub start_microseconds: u64,
+}
+fn birth(pid: i32) -> Option<ProcessBirth> {
+    if pid <= 0 {
+        return None;
+    }
+    let (start_seconds, start_microseconds) = process_start_stamp(pid)?;
+    if start_seconds == 0 || start_microseconds >= 1_000_000 {
+        return None;
+    }
+    Some(ProcessBirth {
+        pid: pid as u32,
+        start_seconds,
+        start_microseconds,
+    })
+}
+
+#[derive(Clone, Copy, Eq, PartialEq)]
+struct StdinPipe {
+    device: u64,
+    inode: u64,
+    mode: u32,
+}
+fn stdin_pipe() -> Option<StdinPipe> {
+    // libc supplies the official native stat ABI. No descriptor is opened,
+    // closed, reconfigured or read by this observation.
+    let mut value = std::mem::MaybeUninit::<libc::stat>::uninit();
+    if unsafe { libc::fstat(libc::STDIN_FILENO, value.as_mut_ptr()) } != 0 {
+        return None;
+    }
+    let value = unsafe { value.assume_init() };
+    if value.st_mode & libc::S_IFMT != libc::S_IFIFO {
+        return None;
+    }
+    Some(StdinPipe {
+        device: value.st_dev as u64,
+        inode: value.st_ino,
+        mode: value.st_mode as u32,
+    })
+}
+
+/// Captured once by the original serve invocation, before accepting clients.
+/// Mode flags describe configured behavior. They do not authenticate the App;
+/// the Host must independently match the actual parent to its signed App pin.
+pub struct EmbeddedObservationContext {
+    instance: String,
+    daemon: Option<ProcessBirth>,
+    parent: Option<ProcessBirth>,
+    stdin: Option<StdinPipe>,
+    embedded: bool,
+    monitor_enabled: bool,
+    monitor_started: AtomicBool,
+    ended: AtomicBool,
+    // The daemon, not a cancellable connection waiter, owns the actual native
+    // reader. One slot bounds CF/TCC concurrency without a queue or new service.
+    reader: Mutex<Option<JoinHandle<ObservationResult>>>,
+}
+impl EmbeddedObservationContext {
+    pub fn capture(embedded: bool, monitor_enabled: bool) -> Self {
+        let parent_pid = unsafe { libc::getppid() };
+        let parent = birth(parent_pid);
+        Self {
+            instance: uuid::Uuid::new_v4().to_string(),
+            daemon: birth(std::process::id() as i32),
+            parent: if unsafe { libc::getppid() } == parent_pid {
+                parent
+            } else {
+                None
+            },
+            stdin: stdin_pipe(),
+            embedded,
+            monitor_enabled,
+            monitor_started: AtomicBool::new(false),
+            ended: AtomicBool::new(false),
+            reader: Mutex::new(None),
+        }
+    }
+    /// Called inside the actual parent-stdin future before its first read.
+    pub fn monitor_started(&self) {
+        self.monitor_started.store(true, Ordering::Release);
+    }
+    /// Called on lifetime EOF/read error and before serve begins terminal drain.
+    pub fn ended(&self) {
+        self.ended.store(true, Ordering::Release);
+    }
+
+    /// A cancelled connection drops only its wait, never the original handle.
+    /// Concurrent readers are refused; no unbounded queue of native calls exists.
+    pub async fn observe_tracked(self: &Arc<Self>) -> ObservationResult {
+        let mut slot = self
+            .reader
+            .try_lock()
+            .map_err(|_| "private_observation_busy")?;
+        if self.ended.load(Ordering::Acquire) {
+            return Err("private_observation_closed");
+        }
+        if let Some(original) = slot.as_mut() {
+            if !original.is_finished() {
+                return Err("private_observation_busy");
+            }
+            // A prior connection may have stopped waiting. Reap that exact
+            // reader; never return its old facts to this new request.
+            let _ = original.await;
+            slot.take();
+        }
+        if self.ended.load(Ordering::Acquire) {
+            return Err("private_observation_closed");
+        }
+        let context = self.clone();
+        *slot = Some(tokio::task::spawn_blocking(move || context.observe()));
+        // Borrow the retained handle across await. Cancelling this future leaves
+        // the original task in the slot for the terminal owner to join.
+        let result = slot.as_mut().expect("original reader stored").await;
+        slot.take();
+        result.map_err(|_| "private_observation_worker_failed")?
+    }
+
+    /// Called after connection abort/join and before SDK/runtime teardown.
+    /// There is deliberately no timeout->success or blocking-task abort here.
+    /// Cancellation of the drain waiter also leaves the original slot intact.
+    pub async fn drain_observations(&self) {
+        self.ended();
+        let mut slot = self.reader.lock().await;
+        if let Some(original) = slot.as_mut() {
+            // Success or panic both mean the original worker actually ended.
+            // A never-returning OS reader keeps shutdown pending, not complete.
+            let _ = original.await;
+            slot.take();
+        }
+    }
+
+    fn observe(&self) -> ObservationResult {
+        if self.ended.load(Ordering::Acquire) {
+            return Err("private_observation_closed");
+        }
+        if !self.embedded || !self.monitor_enabled {
+            return Err("private_observation_requires_embedded_lifetime");
+        }
+        let daemon = self.daemon.ok_or("daemon_birth_unknown")?;
+        let parent = self.parent.ok_or("original_parent_unknown")?;
+        if parent.pid <= 1 || !self.same_processes(daemon, parent) {
+            return Err("original_parent_or_daemon_changed");
+        }
+        let uid = unsafe { libc::getuid() };
+        if uid != unsafe { libc::geteuid() } {
+            return Err("caller_uid_changed");
+        }
+        let first = observation::observe_current();
+        let permissions = current_status(); // No prompt and no descriptor fallback.
+        let second = observation::observe_current();
+        let identity = first
+            .identity
+            .filter(|value| Some(*value) == second.identity);
+        let status =
+            if first.identity != second.identity || first.availability != second.availability {
+                "desktop_session_changed"
+            } else {
+                match second.availability {
+                    Ok(()) => "unlocked",
+                    Err(error) => error.code(),
+                }
+            };
+        if !self.same_processes(daemon, parent)
+            || unsafe { libc::getuid() } != uid
+            || unsafe { libc::geteuid() } != uid
+        {
+            return Err("original_parent_or_daemon_changed");
+        }
+        let original_pipe = self.stdin.is_some() && stdin_pipe() == self.stdin;
+        Ok(NativeObservation {
+            schema: 1,
+            platform: "macos",
+            daemon_instance: self.instance.clone(),
+            uid,
+            daemon,
+            parent,
+            session: SessionObservation {
+                uid: identity.map(|value| value.uid),
+                audit_id: identity.map(|value| value.audit_id),
+                status,
+            },
+            permissions,
+            registry_before: first.registry,
+            registry_after: second.registry,
+            lifetime: LifetimeObservation {
+                embedded_configured: self.embedded,
+                stdin_monitor_enabled: self.monitor_enabled,
+                stdin_monitor_started: self.monitor_started.load(Ordering::Acquire),
+                original_stdin_pipe: original_pipe,
+                ended: self.ended.load(Ordering::Acquire),
+            },
+        })
+    }
+    fn same_processes(&self, daemon: ProcessBirth, parent: ProcessBirth) -> bool {
+        birth(daemon.pid as i32) == Some(daemon)
+            && unsafe { libc::getppid() } == parent.pid as i32
+            && birth(parent.pid as i32) == Some(parent)
+            && unsafe { libc::getppid() } == parent.pid as i32
+    }
+}
+
+#[derive(Serialize)]
+pub struct NativeObservation {
+    schema: u32,
+    platform: &'static str,
+    daemon_instance: String,
+    uid: u32,
+    daemon: ProcessBirth,
+    parent: ProcessBirth,
+    session: SessionObservation,
+    permissions: crate::permissions::PermissionsStatus,
+    registry_before: observation::RegistryObservation,
+    registry_after: observation::RegistryObservation,
+    lifetime: LifetimeObservation,
+}
+#[derive(Serialize)]
+struct SessionObservation {
+    uid: Option<u32>,
+    audit_id: Option<u32>,
+    status: &'static str,
+}
+#[derive(Serialize)]
+struct LifetimeObservation {
+    embedded_configured: bool,
+    stdin_monitor_enabled: bool,
+    stdin_monitor_started: bool,
+    original_stdin_pipe: bool,
+    ended: bool,
+}
