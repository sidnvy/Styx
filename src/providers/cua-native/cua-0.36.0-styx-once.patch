+// Only observed AT-SPI invalidations, not a remote object-generation proof.
+// One atomic word makes activation, checked epoch advance and terminal loss
+// monotonic. No event error/EOF can be revived by late startup publication.
+struct StyxEventFence {
+    state: std::sync::atomic::AtomicU64,
+}
+impl StyxEventFence {
+    const fn new() -> Self {
+        Self { state: std::sync::atomic::AtomicU64::new(0) }
+    }
+    fn activate(&self) {
+        let _ = self.state.compare_exchange(0, 1,
+            std::sync::atomic::Ordering::AcqRel, std::sync::atomic::Ordering::Acquire);
+    }
+    fn capture(&self) -> Option<u64> {
+        match self.state.load(std::sync::atomic::Ordering::Acquire) {
+            0 | u64::MAX => None,
+            value => Some(value),
+        }
+    }
+    fn matches(&self, expected: u64) -> bool {
+        self.capture() == Some(expected)
+    }
+    fn advance(&self) {
+        let _ = self.state.fetch_update(
+            std::sync::atomic::Ordering::AcqRel,
+            std::sync::atomic::Ordering::Acquire,
+            |current| Some(match current {
+                // An event before readiness is conservatively terminal too.
+                0 | u64::MAX => u64::MAX,
+                value => value.checked_add(1).unwrap_or(u64::MAX),
+            }),
+        );
+    }
+    fn lost(&self) {
+        self.state.store(u64::MAX, std::sync::atomic::Ordering::Release);
+    }
+}
+static STYX_EVENT_FENCE: StyxEventFence = StyxEventFence::new();
